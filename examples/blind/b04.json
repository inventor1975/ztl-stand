  {"quantity": "X", "op": ">=", "value": "0.85", "why": "conversion at least 85% in every case"},
  {"quantity": "q", "op": "<=", "value": "RX.jacket", "why": "jacket must remove all heat released, vs its minimum duty"}
 ],
