  "Cin": {"role": "given", "value": "2000", "tolerance": "0.05", "unit": "1/m^3", "why": "feed concentration 2.0 mol/L +-5% (mol treated as a pure count: unit 1/m^3, value 2000)"},
  "k":   {"role": "given", "range": ["0.002135", "0.0051"], "unit": "1/s", "why": "Arrhenius k(T) over T 55..65 C, kref +-10%, Ea +-3%; enclosure computed OUTSIDE the stand (exp not available), outward rounded: 0.1281..0.3060 1/min"},
