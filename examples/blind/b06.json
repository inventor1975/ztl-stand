 "define": {
  "RfT": "Rf*(1 + af*(T - 25))",
  "RgT": "Rg*(1 + ag*(T - 25))",
  "RrT": "Rr*(1 + ar*(T - 25))",
  "CT": "C.C*(1 + C.d)"
 },
 "laws": [
  {
   "zfl": "G*RgT == RgT + RfT",
   "source": "non-inverting amplifier gain, G = 1 + Rf/Rg"
  },
  {
   "zfl": "tau == RrT*CT",
   "source": "RC time constant"
  },
  {
   "zfl": "fc == 1/(2*pi*tau)",
   "source": "first-order cutoff, fc = 1/(2 pi R C)"
  },
  {
   "zfl": "r == fin*2*pi*tau",
   "source": "f/fc = f * 2 pi R C"
  }
 ],
