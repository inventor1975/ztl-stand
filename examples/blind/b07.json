  "L4": "L*L*L*L",
  "mu": "B.ms + wd/g",
  "c1": "5*L4/(384*E*B.I)",
  "c2": "P*L3/(48*E*B.I)"
 },
 "laws": [
  {"zfl": "w == wd + B.ms*g", "source": "load per metre = dead load + self-weight"},
  {"zfl": "M == w*L2/8 + P*L/4", "source": "max moment, simply supported beam, UDL + central point load"},
  {"zfl": "sigma == M/B.W", "source": "bending stress sigma = M/W_el"},
  {"zfl": "delta == w*c1 + c2", "source": "midspan deflection 5wL^4/(384EI) + PL^3/(48EI)"},
  {"zfl": "dm == L/300 - delta", "source": "deflection margin to the L/300 limit"},
  {"zfl": "f1sq == 3.1415*3.1415*E*B.I/(4*L4*mu)", "source": "f1^2 = pi^2 E I /(4 L^4 mu), sqrt-free form; pi taken as 3.1415 (below true pi, conservative)"}
 ],
