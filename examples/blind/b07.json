  {"quantity": "sigma", "op": "<=", "value": "2350/11", "why": "sigma <= fy/gamma = 235/1.10 MPa"},
  {"quantity": "dm", "op": ">=", "value": "0", "why": "delta <= L/300"},
  {"quantity": "f1sq", "op": ">=", "value": "64", "why": "f1 >= 8 Hz, as f1^2 >= 64 Hz^2"}
