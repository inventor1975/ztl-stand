   "role": "derived",
   "unit": "USD"
  }
 },
 "slots": {
  "M": {
   "from": [
    "mortgages"
   ]
  }
 },
 "define": {
  "Pr": "Price - D"
 },
 "laws": [
  {
   "zfl": "A == Pr*M.k",
   "source": "annuity: A = P*r(1+r)^n/((1+r)^n-1); factor k precomputed outside the stand, outward-rounded, over the index range"
  },
  {
   "zfl": "Fee == M.fp*Pr + M.fx",
   "source": "upfront fee = share of principal + fixed amount"
  },
  {
   "zfl": "Slack == 35/100*Inc - A",
   "source": "headroom of the payment under 35% of net monthly income"
  },
  {
   "zfl": "Cash == D + Fee",
   "source": "cash needed up front"
  },
  {
   "zfl": "Tot == M.n*A + Fee",
   "source": "total paid over the term"
  }
 ],
 "requirements": [
  {
   "quantity": "Slack",
   "op": ">=",
   "value": "0",
   "why": "payment <= 35% of net income, every allowed income"
  },
  {
   "quantity": "Cash",
   "op": "<=",
   "value": "78000",
   "why": "down payment + fee <= cash savings"
  }
 ],
 "objective": {
  "minimize": "M.n*M.khi*(Price - Dmin) + M.fp*(Price - Dmin) + M.fx",
  "why": "worst-case total paid (largest principal, highest rate)"
 },
