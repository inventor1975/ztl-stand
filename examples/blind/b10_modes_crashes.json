    },
    {
     "mu": {
      "value": "1700",
      "tolerance": "0.12"
     },
     "price": "1.36",
     "type": "I4"
    }
   ],
   "ground": "problem statement catalog",
   "fields": {
    "mu": {
     "unit": "1/s"
    },
    "price": {
     "unit": "USD"
    }
   }
  },
  "counts": {
   "integers": {
    "field": "N",
    "from": "2",
    "to": "12",
    "unit": ""
   }
  }
 }
