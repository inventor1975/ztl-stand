 },
 "define": {
  "V": "vd*W*Vf",
  "CL": "cl*W*CLf",
  "x": "(CL/V)*REG.tau",
  "S5": "1 + x + x*x/2 + x*x*x/6 + x*x*x*x/24 + x*x*x*x*x/120",
  "EXUP": "S5 + x*x*x*x*x*x/(720*(1 - x/7))"
 },
 "laws": [
  {
   "zfl": "Cmax == (REG.dose/V)*S5/(S5 - 1)",
   "source": "one compartment IV bolus steady state peak, upper bound via Taylor sum"
  },
  {
   "zfl": "Cmin == (REG.dose/V)/(EXUP - 1)",
   "source": "one compartment IV bolus steady state trough, lower bound via Taylor remainder"
  }
 ],
 "requirements": [
  {
   "quantity": "Cmin",
   "op": ">=",
   "value": "10",
   "why": "efficacy"
  },
  {
   "quantity": "Cmax",
   "op": "<=",
   "value": "40",
   "why": "toxicity"
  }
 ],
