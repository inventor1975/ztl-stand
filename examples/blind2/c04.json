{
 "stand": "universal-stand/1",
 "quantities": {
  "Vs": {
   "role": "given",
   "value": "13.6",
   "unit": "V",
   "why": "supply; modes override"
  },
  "Tjk": {
   "role": "given",
   "range": [
    "253.15",
    "368.15"
   ],
   "unit": "K",
   "why": "junction -20..95 C, absolute"
  },
  "dTr": {
   "role": "given",
   "range": [
    "-65",
    "60"
   ],
   "unit": "C",
   "why": "resistor temperature minus 25 C reference (ambient -40..85)"
  },
  "T0": {
   "role": "given",
   "value": "300",
   "unit": "K"
  },
  "kq": {
   "role": "given",
   "value": "517/6000000",
   "unit": "V/K",
   "why": "k/q such that VT = 25.85 mV at 300 K"
  },
  "Egn": {
   "role": "given",
   "value": "3",
   "unit": "V",
   "why": "E_g/n effective 3.0 eV, as eV/e"
  },
  "I": {
   "role": "derived",
   "unit": "mA",
   "search": [
    "1",
    "200"
   ],
   "why": "LED current: diode curve meets resistor line"
  },
  "Pr": {
   "role": "derived",
   "unit": "W",
   "why": "resistor dissipation"
  }
 },
 "slots": {
  "LED": {
   "from": [
    "leds"
   ]
  },
  "R": {
   "from": [
    "carbon_e24_025",
    "metal_e96_025",
    "metal_e96_05"
   ]
  }
 },
 "define": {
  "VT": "kq*Tjk",
  "IS": "LED.Is*(Tjk/T0)**3*exp(Egn/kq*(1/T0 - 1/Tjk))",
  "Rt": "R.R*(1 + R.tc*dTr)"
 },
 "laws": [
  {
   "zfl": "Vs - LED.n*VT*ln(I/IS + 1) == I*Rt",
   "source": "KVL: supply = Shockley diode drop + drop across series resistor with tempco"
  },
  {
   "zfl": "Pr == I*I*Rt",
   "source": "Joule dissipation in the resistor"
  }
 ],
