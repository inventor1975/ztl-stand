   "from": [
    "mLA"
   ]
  },
  "VB": {
   "from": [
    "mLB"
   ]
  }
 },
 "define": {
  "v1": "SYS.q11*VA.N + SYS.q12*VB.N + e1",
  "v2": "SYS.q21*VA.N + SYS.q22*VB.N + e2",
  "n1": "c1*v1",
  "n2": "c2*v2",
  "nHA": "SYS.a1*n1 + SYS.a2*n2",
  "nA": "SYS.b1*n1 + SYS.b2*n2",
  "Iof": "(SYS.i1*n1 + SYS.i2*n2)/Vf",
  "pKap": "SYS.pKa + SYS.dpKa*(T - 25) - (s0 + kI*Iof)",
  "Ka": "pow(10, 0 - pKap)",
  "Hp": "pow(10, 0 - 7.4)",
  "Ctot": "(nHA + nA)/Vf"
 },
 "laws": [
  {
   "zfl": "Ion == Iof",
   "source": "ionic strength: Na+ and anion counted per charge, 1/2*sum(c z^2)"
  },
  {
   "zfl": "pH == pKap + log10(nA/nHA)",
   "source": "Henderson-Hasselbalch with apparent pKa(T, I)",
   "valid": "min(nHA, nA) > 0"
  },
  {
   "zfl": "beta == 2.303*Ctot*Ka*Hp/((Ka + Hp)*(Ka + Hp))",
   "source": "buffer capacity at pH 7.40"
  }
 ],
 "requirements": [
  {
   "quantity": "Ion",
   "op": "<=",
   "value": "0.15",
   "why": "ionic strength limit"
  }
 ],
