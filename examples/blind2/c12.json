{
 "stand": "universal-stand/1",
 "quantities": {
  "fm": {
   "role": "given",
   "value": "20",
   "unit": "kHz",
   "ground": "problem statement: stopband check frequency"
  },
  "f0": {
   "role": "derived",
   "unit": "Hz"
  },
  "Q": {
   "role": "derived",
   "unit": ""
  },
  "D": {
   "role": "derived",
   "unit": "",
   "why": "1/|H(j 2 pi fm)|^2"
  },
  "Att": {
   "role": "derived",
   "unit": "dB"
  },
  "gm": {
   "role": "derived",
   "unit": "Hz",
   "why": "GBW - 150*f0"
  },
  "Rs": {
   "role": "derived",
   "unit": "ohm",
   "why": "R1+R2, actual values"
  },
  "R1w": {
   "role": "derived",
   "unit": "ohm"
  },
  "R2w": {
   "role": "derived",
   "unit": "ohm"
  }
 },
 "slots": {
  "R1": {
   "from": [
    "res_1pct",
    "res_01pct"
   ]
  },
  "R2": {
   "from": [
    "res_1pct",
    "res_01pct"
   ]
  },
  "C1": {
   "from": [
    "cap_e12",
    "cap_e24"
   ]
  },
  "C2": {
   "from": [
    "cap_e12",
    "cap_e24"
   ]
  },
  "OA": {
   "from": [
    "opamps"
   ]
  }
 },
 "define": {
  "Rn1": "R1.R*R1.kT",
  "Rn2": "R2.R*R2.kT",
  "Cn1": "C1.C*C1.kT",
  "Cn2": "C2.C*C2.kT",
  "P": "Rn1*Rn2*Cn1*Cn2",
  "wm2": "(2*pi*fm)*(2*pi*fm)"
 },
 "laws": [
  {
   "zfl": "f0 == 1/(2*pi*sqrt(P))",
   "source": "Sallen-Key unity-gain low-pass: f0 = 1/(2 pi sqrt(R1 R2 C1 C2))"
  },
  {
   "zfl": "Q == sqrt(P)/(Cn2*(Rn1+Rn2))",
   "source": "Sallen-Key unity-gain low-pass: Q = sqrt(R1R2C1C2)/(C2(R1+R2))"
  },
  {
   "zfl": "D == (1 - wm2*P)*(1 - wm2*P) + wm2*Cn2*Cn2*(Rn1+Rn2)*(Rn1+Rn2)",
   "source": "|H(jw)|^-2 = (1 - w^2 R1R2C1C2)^2 + w^2 C2^2 (R1+R2)^2, from H = 1/(1 + s C2(R1+R2) + s^2 R1R2C1C2)"
  },
  {
   "zfl": "Att == 10*log10(D)",
   "source": "attenuation in dB = 10 log10 of the power ratio"
  },
  {
   "zfl": "gm == OA.GBW - 150*f0",
   "source": "problem statement: GBW >= 150 f0 (finite-GBW effect ignored above that)"
  },
  {
   "zfl": "Rs == Rn1 + Rn2",
   "source": "series sum of the two resistors"
  },
  {
   "zfl": "R1w == Rn1",
   "source": "actual resistance of R1"
  },
  {
   "zfl": "R2w == Rn2",
   "source": "actual resistance of R2"
  }
 ],
 "requirements": [
  {
   "quantity": "f0",
   "op": "within",
   "value": [
    "1920",
    "2080"
   ],
   "why": "2.00 kHz +-4 %"
  },
  {
   "quantity": "Q",
   "op": "within",
   "value": [
    "0.64",
    "0.78"
   ],
   "why": "Butterworth 0.707, window 0.64..0.78"
  },
  {
   "quantity": "Att",
   "op": ">=",
   "value": "38",
   "why": "attenuation at 20 kHz >= 38 dB"
  },
  {
   "quantity": "gm",
   "op": ">=",
   "value": "0",
   "why": "GBW >= 150 f0"
  },
  {
   "quantity": "Rs",
   "op": "<=",
   "value": "220000",
   "why": "noise / bias offset"
  },
  {
   "quantity": "R1w",
   "op": ">=",
   "value": "2000",
   "why": "do not load previous stage (worst-case actual R)"
  },
  {
   "quantity": "R2w",
   "op": ">=",
   "value": "2000",
   "why": "do not load previous stage (worst-case actual R)"
  }
 ],
 "objective": {
  "minimize": "R1.price+R2.price+C1.price+C2.price+OA.price",
  "why": "cheapest bill of materials"
 },
