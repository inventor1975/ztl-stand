 "define": {
  "Rw": "Rsi + dpl/lpl + dbr/lbr + INS.x/INS.lam + dre/lre + Rse"
 },
 "computed": {
  "Uwn": {
   "value": "1/(Rsi + dpl/lpl + dbr/lbr_n + INS.x/INS.lam_n + dre/lre + Rse)",
   "unit": "W/(m^2*K)"
  },
  "HTn": {
   "value": "(Uwn + Ubr)*Aw + WIN.U_n*Awin + Urn*Ar + bg*Ufn*Af",
   "unit": "W/K"
  },
  "Hn": {
   "value": "HTn + nac_n*Vol*cair",
   "unit": "W/K"
  },
  "En": {
   "value": "Hn*DD_n - Gain_n",
   "unit": "kWh"
  },
  "cost20": {
   "value": "(INS.p0 + INS.p1*INS.x)*Aw + WIN.price*Awin + HP.price + 20*En/COP_n*pel",
   "unit": "EUR"
  }
 },
 "laws": [
  {
   "zfl": "Uwb == 1/Rw",
   "source": "U = 1/sum R, layers inside to outside incl. surface resistances (no bridges)"
  },
  {
   "zfl": "HT == (Uwb + Ubr)*Aw + WIN.U*Awin + Ur*Ar + bg*Uf*Af",
   "source": "transmission loss H_T = sum U A (b on floor); wall incl. +0.05 bridges"
  },
  {
   "zfl": "HV == nac*Vol*cair",
   "source": "ventilation loss n V c_air"
  },
  {
   "zfl": "Htot == HT + HV",
   "source": "total specific heat loss"
  },
  {
   "zfl": "Umean == HT/Aenv",
   "source": "mean envelope U = H_T/348"
  },
  {
   "zfl": "Pmargin == HP.Pnom*(1 + kcap*(Tout - Tnom)) - Htot*(Tin - Tout)",
   "source": "HP capacity P_nom(1+0.015(T+7)) minus design heat loss"
  },
  {
   "zfl": "Eht == Htot*DD",
   "source": "annual heat: H * degree-days"
  },
  {
   "zfl": "Enet == Eht - Gain",
   "source": "net heating energy = heat minus free gains"
  }
 ],
 "requirements": [
  {
   "quantity": "Uwb",
   "op": "<=",
   "value": "0.22",
   "why": "wall U without bridges <= 0.22"
  },
  {
   "quantity": "Umean",
