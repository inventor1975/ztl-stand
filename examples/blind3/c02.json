   "value": "0",
   "why": "HP covers design heat loss at worst T and tolerance"
  },
  {
   "quantity": "Enet",
   "op": "<=",
   "value": "9000",
   "why": "net heating energy <= 9000 kWh/a at worst case"
  }
 ],
 "objective": {
  "minimize": "cost20",
