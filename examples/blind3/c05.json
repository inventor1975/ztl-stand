  "Kop": "if(xop <= 1/5, 21/10 - 3/2*xop, if(xop <= 2/5, 9/5 + 1/2*(xop - 1/5), if(xop <= 3/5, 19/10 + 3/2*(xop - 2/5), if(xop <= 4/5, 11/5 + 3/2*(xop - 3/5), if(xop <= 22/25, 5/2 + 5/2*(xop - 4/5), if(xop <= 47/50, 27/10 - 35/3*(xop - 22/25), if(xop <= 197/200, 2 - 200/9*(xop - 47/50), 1 - 200/3*(xop - 197/200))))))))",
  "Ks": "if(xs <= 1/5, 21/10 - 3/2*xs, if(xs <= 2/5, 9/5 + 1/2*(xs - 1/5), if(xs <= 3/5, 19/10 + 3/2*(xs - 2/5), if(xs <= 4/5, 11/5 + 3/2*(xs - 3/5), if(xs <= 22/25, 5/2 + 5/2*(xs - 4/5), if(xs <= 47/50, 27/10 - 35/3*(xs - 22/25), if(xs <= 197/200, 2 - 200/9*(xs - 47/50), 1 - 200/3*(xs - 197/200))))))))"
 },
 "laws": [
  {
   "zfl": "M.Tn*Kop*Vs2 == Tlm",
   "source": "operating point: motor curve (x V^2) meets load torque at motor shaft"
  },
  {
   "zfl": "TL == F*D/2",
   "source": "load torque at drum"
  },
  {
   "zfl": "Tbk == 3/2*TL",
   "source": "breakaway = 1.5 x running"
  },
  {
   "zfl": "Tsh == TL/(RAT.i*RAT.eta)",
   "source": "load torque at motor shaft"
  },
  {
   "zfl": "v == pi*D*M.ns*xop/RAT.i",
   "source": "belt speed = pi D n_motor / i"
  },
  {
   "zfl": "vrel == v/vreq",
   "source": "relative to required speed"
  },
  {
   "zfl": "mb == M.Tn*Ks*Vs2 - kb*Tlm - M.Tn/4",
   "source": "requirement (b): motor torque minus start-case load torque minus 25% Tn"
  }
 ],
