   "unit": ""
  },
  "W": {
   "value": "SL.Dem*(1 - PL.red)",
   "unit": "kg/m^3"
  },
  "C": {
   "value": "W/WC.v",
   "unit": "kg/m^3"
  },
  "Magn": {
   "value": "RHOA*(1 - C/RHOC - W/RHOW - airn)",
   "unit": "kg/m^3"
  },
  "Cost": {
   "value": "C*CEM.price + C*PL.use*PL.price + Magn*(BL.xs*Ps + BL.xa*Pa + BL.xb*Pb) + Over",
   "unit": "EUR/m^3"
  }
 },
 "laws": [
  {
   "zfl": "fm == if(WC.v <= W45, F40 + (F45 - F40)*(WC.v - W40)/(W45 - W40), if(WC.v <= W50, F45 + (F50 - F45)*(WC.v - W45)/(W50 - W45), F50 + (F55 - F50)*(WC.v - W50)/(W55 - W50))) - CEM.dC + etab",
   "source": "28-day strength table, linear interpolation in w/c; CEM II minus 3 MPa; table scatter +-2"
  },
  {
   "zfl": "Cdel == C",
   "source": "cement content = total mix water / (w/c)"
  },
  {
   "zfl": "Mag == RHOA*(1 - C/RHOC - W/RHOW - air)",
   "source": "volume balance per m^3: cement/3150 + water/1000 + aggregate/2650 + air = 1"
  },
  {
   "zfl": "Wsand == mois*BL.xs*Mag",
   "source": "water carried by the sand (moisture by mass of sand)"
  },
  {
   "zfl": "Wfree == W - Wsand",
   "source": "free water to add = total mix water - sand moisture water"
  },
  {
   "zfl": "P025 == min(1, max(0, S025 + e025))",
   "source": "combined passing at sieve 025 mm: blend-weighted fractions, +-3 pts sieving error, clipped to 0..100%"
  },
  {
   "zfl": "P1 == min(1, max(0, S1 + e1))",
   "source": "combined passing at sieve 1 mm: blend-weighted fractions, +-3 pts sieving error, clipped to 0..100%"
  },
  {
   "zfl": "P4 == min(1, max(0, S4 + e4))",
   "source": "combined passing at sieve 4 mm: blend-weighted fractions, +-3 pts sieving error, clipped to 0..100%"
  },
  {
   "zfl": "P16 == min(1, max(0, S16 + e16))",
   "source": "combined passing at sieve 16 mm: blend-weighted fractions, +-3 pts sieving error, clipped to 0..100%"
  },
  {
   "zfl": "P32 == min(1, max(0, S32 + e32))",
   "source": "combined passing at sieve 32 mm: blend-weighted fractions, +-3 pts sieving error, clipped to 0..100%"
  }
 ],
