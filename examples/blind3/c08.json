  "FIT": {
   "from": [
    "fits"
   ]
  }
 },
 "define": {
  "Kc": "((D*D + d*d)/(D*D - d*d) + HUB.nu)/HUB.E + (1 - nus)/Es",
  "Wc": "(D*D + d*d)/(D*D - d*d)",
  "dE": "FIT.I - 0.4*(Rzs + Rzh) - d*(HUB.alpha - alphas)*(T - 20)"
 },
 "laws": [
  {
   "zfl": "p == dE/(d*Kc)",
   "source": "thick-walled hub on solid shaft (Lame): effective interference = p d Kc; effective interference = nominal - roughness smoothing + thermal term"
  },
  {
   "zfl": "Tcap == mu*p*pi*d*d*L/2",
   "source": "friction torque capacity"
  },
  {
   "zfl": "sigt == p*Wc",
   "source": "hoop stress at hub bore"
  },
  {
   "zfl": "dTa == (FIT.Imax + clr)/(d*HUB.alpha)",
   "source": "hot-assembly temperature rise = clearance / (d alpha_h)"
  }
 ],
 "requirements": [
  {
   "quantity": "Tcap",
   "op": ">=",
   "value": "2*Tpeak",
   "why": "slip safety 2.0 against the +10% peak torque, worst mu, worst T, min interference"
  },
  {
   "quantity": "sigt",
   "op": "<=",
   "value": "HUB.sig",
   "why": "hoop stress at the bore <= allowable, max interference, coldest T"
  },
  {
   "quantity": "dTa",
   "op": "<=",
   "value": "dTmax",
   "why": "hub heating for assembly <= 230 K"
  }
 ],
 "objective": {
  "minimize": "HUB.price + FIT.price",
  "why": "cheapest hub + machining"
 },
