 "define": {
  "S": "(100 - moist)/86"
 },
 "computed": {
  "cost0": "(MIX.xmz*205+MIX.xwh*220+MIX.xsb*480+MIX.xsf*290+MIX.xfm*1250+MIX.xol*980+MIX.xls*55+MIX.xdp*520+MIX.xly*1900+MIX.xme*3200)/100+7"
 },
 "where": [
  "MIX.xsf <= 10",
  "MIX.xfm <= 5",
  "MIX.xol <= 4",
  "MIX.xly <= 2/5",
  "MIX.xme <= 3/10",
  "MIX.xmz + MIX.xwh >= 45",
  "MIX.xmz+MIX.xwh+MIX.xsb+MIX.xsf+MIX.xfm+MIX.xol+MIX.xls+MIX.xdp+MIX.xly+MIX.xme == 496/5"
 ],
 "laws": [
  {
   "zfl": "ME == (MIX.xmz*ME_mz*S + MIX.xwh*ME_wh + MIX.xsb*ME_sb + MIX.xsf*ME_sf + MIX.xfm*ME_fm + MIX.xol*ME_ol)/100",
   "source": "sum of inclusion x ME per kg of mix, kcal/kg; maize scaled by moisture"
  },
  {
   "zfl": "CP == (MIX.xmz*CP_mz*S + MIX.xwh*CP_wh + MIX.xsb*CP_sb + MIX.xsf*CP_sf + MIX.xfm*CP_fm + MIX.xol*CP_ol + MIX.xls*CP_ls + MIX.xdp*CP_dp + MIX.xly*CP_ly + MIX.xme*CP_me)/100",
   "source": "sum of inclusion x CP, % of mix"
  },
  {
   "zfl": "LYS == (MIX.xmz*LY_mz*S + MIX.xwh*LY_wh + MIX.xsb*LY_sb + MIX.xsf*LY_sf + MIX.xfm*LY_fm + MIX.xly*LY_ly)/100",
   "source": "sum of inclusion x Lys, % of mix"
  },
  {
   "zfl": "MCY == (MIX.xmz*MC_mz*S + MIX.xwh*MC_wh + MIX.xsb*MC_sb + MIX.xsf*MC_sf + MIX.xfm*MC_fm + MIX.xme*MC_me)/100",
   "source": "sum of inclusion x Met+Cys, % of mix"
  },
  {
   "zfl": "Ca == (MIX.xmz*0.02*S + MIX.xwh*0.05 + MIX.xsb*0.3 + MIX.xsf*0.4 + MIX.xfm*5.0 + MIX.xls*38 + MIX.xdp*22)/100",
   "source": "sum of inclusion x Ca, % of mix"
  },
  {
   "zfl": "AP == (MIX.xmz*0.08*S + MIX.xwh*0.13 + MIX.xsb*0.2 + MIX.xsf*0.25 + MIX.xfm*2.8 + MIX.xdp*18)/100",
   "source": "sum of inclusion x avP, % of mix"
  },
  {
   "zfl": "D1 == Ca - 9/5*AP",
   "source": "Ca:avP >= 1.8  <=>  Ca - 1.8 avP >= 0  (avP > 0)"
  },
  {
   "zfl": "D2 == 12/5*AP - Ca",
   "source": "Ca:avP <= 2.4  <=>  2.4 avP - Ca >= 0  (avP > 0)"
  },
  {
   "zfl": "FIB == (MIX.xmz*2.2*S + MIX.xwh*2.5 + MIX.xsb*3.9 + MIX.xsf*18 + MIX.xfm*1.0)/100",
   "source": "sum of inclusion x fibre, % of mix"
  },
  {
   "zfl": "Cost == (MIX.xmz*p_mz + MIX.xwh*p_wh + MIX.xsb*p_sb + MIX.xsf*p_sf + MIX.xfm*p_fm + MIX.xol*p_ol + MIX.xls*p_ls + MIX.xdp*p_dp + MIX.xly*p_ly + MIX.xme*p_me)/100 + premix_cost",
   "source": "price per tonne of mix; premix 0.5% x 1400 = 7 EUR/t; salt unpriced"
  }
 ],
