  "Rcap": {
   "value": "kq*(M1.N*Q1*(RJ1 - dr) + M2.N*Q2*(RJ2 - dr) + M3.N*Q3*(RJ3 - dr) + M4.N*Q4*(RJ4 - dr) + M5.N*Q5*(RJ5 - dr))",
   "unit": "kg/h"
  },
  "Qtot": {
   "value": "kq*(M1.N*Q1 + M2.N*Q2 + M3.N*Q3 + M4.N*Q4 + M5.N*Q5)",
   "unit": "kg/h"
  }
 },
 "where": [
  "M1.N + M2.N + M3.N + M4.N + M5.N <= 8",
  "Qtot <= qmax*FH"
 ],
 "laws": [
  {
   "zfl": "cAo == cT + gA/FA",
   "source": "stage A balance, imp.1"
  },
  {
   "zfl": "FB*cBi == x*cAo + (FB - x)*cT",
   "source": "stage B inlet mix, imp.1"
  },
  {
   "zfl": "cBo == cBi + gB/FB",
   "source": "stage B balance, imp.1"
  },
  {
   "zfl": "FH*cH == (FA - x)*cAo + FB*cBo",
   "source": "header mix, imp.1"
  },
  {
   "zfl": "FH*cT == ((1 - P.p)*FH - Rcap)*cH + P.p*FH*cm",
   "source": "tank balance with purge and module removal, imp.1"
  },
  {
   "zfl": "cAo2 == cT2 + g2/FA",
   "source": "stage A balance, imp.2"
  },
  {
   "zfl": "FB*cBi2 == x*cAo2 + (FB - x)*cT2",
   "source": "stage B inlet mix, imp.2"
  },
  {
   "zfl": "cBo2 == cBi2",
   "source": "stage B balance, imp.2 (gB = 0)"
  },
  {
   "zfl": "FH*cH2 == (FA - x)*cAo2 + FB*cBo2",
   "source": "header mix, imp.2"
  },
  {
   "zfl": "FH*cT2 == (1 - P.p)*FH*cH2 + P.p*FH*cm2",
   "source": "tank balance, imp.2 (no removal)"
  }
 ],
