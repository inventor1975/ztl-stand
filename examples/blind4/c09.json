 "define": {
  "h0": "hu*if(vk <= 5*vu, 12 + 16*vk/(5*vu), if(vk <= 10*vu, 28 + 17*(vk-5*vu)/(5*vu), if(vk <= 15*vu, 45 + 17*(vk-10*vu)/(5*vu), 62)))",
  "Pgrav": "m*g*sl*vk",
  "Proll": "0.012*m*g*vk",
  "Pair": "0.5*rho*CdA*vk**3",
  "Pret": "RET.P40*vk/vref",
  "Pf": "max(0, Pgrav - Proll - Pair - Pret)",
  "Pdf": "0.92*Pf*0.65/2",
  "Pdr": "0.92*Pf*0.35/2",
  "hAf": "fh*h0*F.A",
  "hAr": "fh*h0*RR.A",
  "tf": "F.mass*cp/hAf",
  "tr": "RR.mass*cp/hAr",
  "tt": "Lk/vk",
  "Tssf": "Ta + Pdf/hAf",
  "Tssr": "Ta + Pdr/hAr"
 },
 "laws": [
  {
   "zfl": "Tf == Tssf - (Tssf - Ta - dT0)*exp(-tt/tf)",
   "source": "disc Newton cooling T(t)=Tss-(Tss-T0)exp(-t/tau), front disc"
  },
  {
   "zfl": "Tr == Tssr - (Tssr - Ta - dT0)*exp(-tt/tr)",
   "source": "same, rear disc"
  },
  {
   "zfl": "muf == if(Tf <= 100*Tu, PAD.m20 + (PAD.m100-PAD.m20)*(max(Tf,20*Tu)-20*Tu)/(80*Tu), if(Tf <= 300*Tu, PAD.m100 + (PAD.m300-PAD.m100)*(Tf-100*Tu)/(200*Tu), if(Tf <= 450*Tu, PAD.m300 + (PAD.m450-PAD.m300)*(Tf-300*Tu)/(150*Tu), if(Tf <= 550*Tu, PAD.m450 + (PAD.m550-PAD.m450)*(Tf-450*Tu)/(100*Tu), if(Tf <= 650*Tu, PAD.m550 + (PAD.m650-PAD.m550)*(Tf-550*Tu)/(100*Tu), PAD.m650)))))",
   "source": "pad mu(T) piecewise linear, front disc temperature"
  },
  {
   "zfl": "mur == if(Tr <= 100*Tu, PAD.m20 + (PAD.m100-PAD.m20)*(max(Tr,20*Tu)-20*Tu)/(80*Tu), if(Tr <= 300*Tu, PAD.m100 + (PAD.m300-PAD.m100)*(Tr-100*Tu)/(200*Tu), if(Tr <= 450*Tu, PAD.m300 + (PAD.m450-PAD.m300)*(Tr-300*Tu)/(150*Tu), if(Tr <= 550*Tu, PAD.m450 + (PAD.m550-PAD.m450)*(Tr-450*Tu)/(100*Tu), if(Tr <= 650*Tu, PAD.m550 + (PAD.m650-PAD.m550)*(Tr-550*Tu)/(100*Tu), PAD.m650)))))",
   "source": "pad mu(T) piecewise linear, rear disc temperature"
  },
  {
   "zfl": "Fav == 0.9*fK*fmu*(muf*F.Kf + mur*RR.Kr)",
   "source": "available stop force; K in kN so x1000 N"
  }
 ],
 "requirements": [
  {
   "quantity": "Tf",
   "op": "<=",
   "value": "600",
   "why": "R1 front disc end temperature <= 600 C"
  },
  {
   "quantity": "Tr",
