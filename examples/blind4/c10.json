  },
  {
   "zfl": "ET4 == if(PH4 < TB.phimin, 0, if(PH4 < 0.3, TB.e02 + SL1*(PH4-0.2), if(PH4 < 0.4, TB.e03 + SL2*(PH4-0.3), if(PH4 < 0.6, TB.e04 + SL3*(PH4-0.4), if(PH4 < 0.8, TB.e06 + SL4*(PH4-0.6), TB.e08 + SL5*(PH4-0.8))))))",
   "source": "turbine efficiency curve, linear between listed fractions, zero below phimin (shut down)"
  },
  {
