 "define": {
  "AU": "pi*UP.D*UP.D/4",
  "AL": "pi*LO.D*LO.D/4",
  "KU": "10.67*LU/(pow(UP.C,1.852)*pow(UP.D/D0,4.87))",
  "KL": "10.67*LL/(pow(LO.C,1.852)*pow(LO.D/D0,4.87))",
  "SL1": "(TB.e03-TB.e02)/0.1",
  "SL2": "(TB.e04-TB.e03)/0.1",
  "SL3": "(TB.e06-TB.e04)/0.2",
  "SL4": "(TB.e08-TB.e06)/0.2",
  "SL5": "(TB.e10-TB.e08)/0.2"
 },
 "laws": [
  {
   "zfl": "QF*QF == TB.K2*(HG - KU*pow(QF/Q0,1.852) - KL*pow(QF/Q0,1.852))",
   "source": "turbine full flow QF=K sqrt(Hnet(QF)) squared, Hnet = Hg - HW loss(upper) - HW loss(lower)"
  },
  {
   "zfl": "Q1 == min(f*QR1, QF)",
   "source": "flow used = min(river flow, turbine full flow)"
  },
  {
   "zfl": "PH1 == Q1/QF",
   "source": "flow fraction"
  },
  {
   "zfl": "HN1 == HG - KU*pow(Q1/Q0,1.852) - KL*pow(Q1/Q0,1.852)",
   "source": "net head at the flow used (Hazen-Williams, both sections)"
  },
  {
   "zfl": "ET1 == if(PH1 < TB.phimin, 0, if(PH1 < 0.3, TB.e02 + SL1*(PH1-0.2), if(PH1 < 0.4, TB.e03 + SL2*(PH1-0.3), if(PH1 < 0.6, TB.e04 + SL3*(PH1-0.4), if(PH1 < 0.8, TB.e06 + SL4*(PH1-0.6), TB.e08 + SL5*(PH1-0.8))))))",
   "source": "turbine efficiency curve, linear between listed fractions, zero below phimin (shut down)"
  },
  {
   "zfl": "P1 == ET1*ETAG*RHO*G*Q1*HN1",
   "source": "electric power"
  },
  {
   "zfl": "Q2 == min(f*QR2, QF)",
   "source": "flow used = min(river flow, turbine full flow)"
  },
  {
   "zfl": "PH2 == Q2/QF",
   "source": "flow fraction"
  },
  {
   "zfl": "HN2 == HG - KU*pow(Q2/Q0,1.852) - KL*pow(Q2/Q0,1.852)",
   "source": "net head at the flow used (Hazen-Williams, both sections)"
  },
  {
   "zfl": "ET2 == if(PH2 < TB.phimin, 0, if(PH2 < 0.3, TB.e02 + SL1*(PH2-0.2), if(PH2 < 0.4, TB.e03 + SL2*(PH2-0.3), if(PH2 < 0.6, TB.e04 + SL3*(PH2-0.4), if(PH2 < 0.8, TB.e06 + SL4*(PH2-0.6), TB.e08 + SL5*(PH2-0.8))))))",
   "source": "turbine efficiency curve, linear between listed fractions, zero below phimin (shut down)"
  },
  {
   "zfl": "P2 == ET2*ETAG*RHO*G*Q2*HN2",
   "source": "electric power"
  },
  {
   "zfl": "Q3 == min(f*QR3, QF)",
   "source": "flow used = min(river flow, turbine full flow)"
  },
  {
   "zfl": "PH3 == Q3/QF",
   "source": "flow fraction"
  },
  {
   "zfl": "HN3 == HG - KU*pow(Q3/Q0,1.852) - KL*pow(Q3/Q0,1.852)",
   "source": "net head at the flow used (Hazen-Williams, both sections)"
  },
  {
   "zfl": "ET3 == if(PH3 < TB.phimin, 0, if(PH3 < 0.3, TB.e02 + SL1*(PH3-0.2), if(PH3 < 0.4, TB.e03 + SL2*(PH3-0.3), if(PH3 < 0.6, TB.e04 + SL3*(PH3-0.4), if(PH3 < 0.8, TB.e06 + SL4*(PH3-0.6), TB.e08 + SL5*(PH3-0.8))))))",
   "source": "turbine efficiency curve, linear between listed fractions, zero below phimin (shut down)"
  },
  {
   "zfl": "P3 == ET3*ETAG*RHO*G*Q3*HN3",
   "source": "electric power"
  },
  {
   "zfl": "Q4 == min(f*QR4, QF)",
   "source": "flow used = min(river flow, turbine full flow)"
  },
  {
