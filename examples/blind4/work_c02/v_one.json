 "slots": {
  "AN": {
   "from": [
    "anodes"
   ]
  },
  "CNT": {
   "from": [
    "counts"
   ]
  }
 },
 "define": {
  "R1w": "rho_w/(2*pi*AN.L)*(ln(4*AN.L/AN.d) - 1)",
  "R1d": "rho_d/(2*pi*AN.L)*(ln(4*AN.L/AN.d) - 1)",
  "Rtw": "R1w/CNT.N*(1 + 0.15*ln(CNT.N)) + Rc",
  "Rtd": "R1d/CNT.N*(1 + 0.15*ln(CNT.N)) + Rc"
 },
 "laws": [
  {
   "zfl": "Iw*Rtw == AN.Ea - Vp - beta*log10(Iw/Ip)",
   "source": "circuit I*(Rgroup+Rc)=Ea-Es with steel polarisation Es=0.85+beta*log10(I/Ip), wet season (implicit)"
  },
  {
   "zfl": "Id*Rtd == AN.Ea - Vp - beta*log10(Id/Ip)",
   "source": "same, dry season (implicit)"
  },
  {
   "zfl": "Esw == AN.Ea - Iw*Rtw",
   "source": "circuit equation, wet"
  },
  {
   "zfl": "Esd == AN.Ea - Id*Rtd",
   "source": "circuit equation, dry"
  },
  {
   "zfl": "Iavg == 0.5*Iw + 0.5*Id",
   "source": "each season is half of the life"
  },
  {
   "zfl": "Life == CNT.N*AN.m*AN.cap*Util/Iavg",
   "source": "Faraday: charge = n*m*capacity*utilisation, delivered at Iavg"
  }
 ],
