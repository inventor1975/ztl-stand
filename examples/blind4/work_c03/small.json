 "laws": [
  {
   "zfl": "alphap == -ln(UVTp)/ONECM",
   "source": "Beer-Lambert: alpha = -ln(UVT/100) per cm"
  },
  {
   "zfl": "attp == exp(-alphap*(CH.R - CH.rq))",
   "source": "attenuation from sleeve to wall"
  },
  {
   "zfl": "fTp == min(min(0.88 + (0.08/6)*(Twp - 8), 0.96 + (0.04/6)*(Twp - 14)), min(1 - (0.03/6)*(Twp - 20), 0.97 - 0.01*(Twp - 26)))",
   "source": "lamp output factor vs water temperature (concave piecewise-linear = min of its 4 segment lines, exact on 8..30 degC)"
  },
  {
   "zfl": "tp == pi*(CH.R*CH.R - CH.rq*CH.rq)*CH.L/(Qp/NN.N)",
   "source": "residence time t = V/(Q/n), V = pi (R^2 - rq^2) L"
  },
  {
   "zfl": "Dp == VAL*(CH.Puv*DP.x*AGE*FOUL*fTp/(2*pi*CH.R*CH.L))*attp*tp",
   "source": "fluence = 0.7 * I_wall * t, I_wall = Puv dim a f_foul f_T/(2 pi R L) exp(-alpha (R-rq))"
  },
  {
   "zfl": "LRp == KK*Dp/ln(10)",
   "source": "first-order inactivation: log-reduction = k D / ln10"
  },
  {
   "zfl": "alphaa == -ln(UVTa)/ONECM",
   "source": "Beer-Lambert: alpha = -ln(UVT/100) per cm"
  },
  {
   "zfl": "atta == exp(-alphaa*(CH.R - CH.rq))",
   "source": "attenuation from sleeve to wall"
  },
  {
   "zfl": "fTa == min(min(0.88 + (0.08/6)*(Twa - 8), 0.96 + (0.04/6)*(Twa - 14)), min(1 - (0.03/6)*(Twa - 20), 0.97 - 0.01*(Twa - 26)))",
   "source": "lamp output factor vs water temperature (concave piecewise-linear = min of its 4 segment lines, exact on 8..30 degC)"
  },
  {
   "zfl": "ta == pi*(CH.R*CH.R - CH.rq*CH.rq)*CH.L/(Qa/NN.N)",
   "source": "residence time t = V/(Q/n), V = pi (R^2 - rq^2) L"
  },
  {
   "zfl": "Da == VAL*(CH.Puv*DA.x*AGE*FOUL*fTa/(2*pi*CH.R*CH.L))*atta*ta",
   "source": "fluence = 0.7 * I_wall * t, I_wall = Puv dim a f_foul f_T/(2 pi R L) exp(-alpha (R-rq))"
  },
  {
   "zfl": "LRa == KK*Da/ln(10)",
   "source": "first-order inactivation: log-reduction = k D / ln10"
  },
  {
   "zfl": "alphal == -ln(UVTl)/ONECM",
   "source": "Beer-Lambert: alpha = -ln(UVT/100) per cm"
  },
  {
   "zfl": "attl == exp(-alphal*(CH.R - CH.rq))",
   "source": "attenuation from sleeve to wall"
  },
  {
   "zfl": "fTl == min(min(0.88 + (0.08/6)*(Twl - 8), 0.96 + (0.04/6)*(Twl - 14)), min(1 - (0.03/6)*(Twl - 20), 0.97 - 0.01*(Twl - 26)))",
   "source": "lamp output factor vs water temperature (concave piecewise-linear = min of its 4 segment lines, exact on 8..30 degC)"
  },
  {
   "zfl": "tl == pi*(CH.R*CH.R - CH.rq*CH.rq)*CH.L/(Ql/NN.N)",
   "source": "residence time t = V/(Q/n), V = pi (R^2 - rq^2) L"
  },
  {
   "zfl": "Dl == VAL*(CH.Puv*DL.x*AGE*FOUL*fTl/(2*pi*CH.R*CH.L))*attl*tl",
   "source": "fluence = 0.7 * I_wall * t, I_wall = Puv dim a f_foul f_T/(2 pi R L) exp(-alpha (R-rq))"
  },
  {
   "zfl": "LRl == KK*Dl/ln(10)",
   "source": "first-order inactivation: log-reduction = k D / ln10"
  },
  {
   "zfl": "Pel == NN.N*(CH.kW*DP.x + Pb)",
   "source": "electric power at the Peak dimming: n (kW100 dim + 0.03 kW)"
  }
