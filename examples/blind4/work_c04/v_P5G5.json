 "define": {
  "Nr": "N/URPM",
  "nn": "Nr/(60*GR.i)*HZ",
  "Tab": "if(Nr > 800, if(Nr > 1000, if(Nr > 1400, if(Nr > 1800, if(Nr > 2000, if(Nr > 2150, 0, 1430 - (1430/150)*(Nr - 2000)), 1450 - (1/10)*(Nr - 1800)), 1500 - (1/8)*(Nr - 1400)), 1250 + (5/8)*(Nr - 1000)), 1000 + (1/4)*(Nr - 800)), 1000)",
  "Te": "fE*Tab*TQ1",
  "KQn": "Te*GR.i*eg/(rho*nn*nn*PR.D*PR.D*PR.D*PR.D*PR.D)",
  "Jt": "(PR.J0/(3/4))*(1 - KQn/(PR.KQ0*fKQ))",
  "Jd": "if(bol > 0.5, 0, Jt)",
  "Vk": "Jd*nn*PR.D/(1 - w)/KN",
  "Rtab": "if(Vk > 4, if(Vk > 6, if(Vk > 8, if(Vk > 9, if(Vk > 10, if(Vk > 11, if(Vk > 12, if(Vk > 13, 64 + 17*(Vk - 13), 47 + 17*(Vk - 12)), 34 + 13*(Vk - 11)), 25 + 9*(Vk - 10)), 18.5 + (13/2)*(Vk - 9)), 13.5 + 5*(Vk - 8)), 7 + (13/4)*(Vk - 6)), 3 + 2*(Vk - 4)), (3/4)*Vk)"
 },
 "laws": [
  {
   "zfl": "if(bol > 0.5, PR.KQ0*fKQ*rho*nn*nn*PR.D*PR.D*PR.D*PR.D, (1 - t)*fKT*PR.KT0*(1 - Jd/PR.J0)*rho*nn*nn*PR.D*PR.D*PR.D*PR.D) == if(bol > 0.5, Te*GR.i*eg/PR.D, fres*Rtab*KNF)",
   "source": "operating point: free running = net thrust equals hull resistance while propeller torque (through J from the torque balance) equals engine torque curve; bollard (bol=1) = J=0, propeller torque equals engine torque, force form Q_p/D"
  },
  {
   "zfl": "Tnet == (1 - t)*fKT*PR.KT0*(1 - Jd/PR.J0)*rho*nn*nn*PR.D*PR.D*PR.D*PR.D",
   "source": "T = K_T rho n^2 D^4, net T(1-t)"
  },
  {
   "zfl": "Vkn == Vk",
   "source": "speed through water V from J = V(1-w)/(nD), in knots"
  },
  {
   "zfl": "Tip == pi*nn*PR.D",
   "source": "tip speed"
  },
  {
   "zfl": "Jm == PR.J0 - Jd",
   "source": "linear K_T/K_Q model valid for J <= J0"
  }
 ],
