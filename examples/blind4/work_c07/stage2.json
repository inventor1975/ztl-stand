{
 "stand": "universal-stand/1",
 "quantities": {
  "T": {
   "role": "given",
   "range": [
    "253.15",
    "333.15"
   ],
   "unit": "K"
  },
  "T0": {
   "role": "given",
   "value": "298.15",
   "unit": "K",
   "ground": "NTC model reference temperature 25 degC"
  },
  "Dk": {
   "role": "given",
   "value": "1",
   "unit": "K",
   "why": "safety margin in the slope bound: slope evaluated at T-1 K"
  },
  "E_R25": {
   "role": "derived",
   "unit": "K"
  },
  "E_B": {
   "role": "derived",
   "unit": "K"
  },
  "E_adc_lb": {
   "role": "derived",
   "unit": "K",
   "why": "ADC error >= dx / max slope of x(T); max slope of x(T) <= B/(4 T^2) for ANY Rp, Rpar"
  },
  "E_rp_lb": {
   "role": "derived",
   "unit": "K",
   "why": "pull-up tolerance error >= its value at Rpar = infinity limit g=0 (monotone in g)"
  },
  "Elb": {
   "role": "derived",
   "unit": "K",
   "why": "lower bound of the total error, valid for every Rp, Rpar"
  }
 },
 "slots": {
  "NTC": {
   "from": [
    "ntc"
   ]
  },
  "ADC": {
   "from": [
    "adc"
   ]
  },
  "CL": {
   "from": [
    "cls"
   ]
  }
 },
 "define": {
  "Dxa": "(ADC.tue + 1/2)*ADC.lsb",
  "Du": "(1/T - 1/T0)",
  "dR25p": "ln(1 + NTC.tR)",
  "dR25m": "ln(1 - NTC.tR)",
  "dBp": "NTC.B*NTC.tB*Du",
  "dBm": "0 - NTC.B*NTC.tB*Du",
  "dRpp": "0 - ln(1 + CL.t)",
  "dRpm": "0 - ln(1 - CL.t)"
 },
 "laws": [
  {
   "zfl": "E_R25 == max(max((0 - T*T*(dR25p)/(NTC.B + T*(dR25p))), 0 - (0 - T*T*(dR25p)/(NTC.B + T*(dR25p)))), max((0 - T*T*(dR25m)/(NTC.B + T*(dR25m))), 0 - (0 - T*T*(dR25m)/(NTC.B + T*(dR25m)))))",
   "source": "same as c07.json"
  },
  {
   "zfl": "E_B == max(max((0 - T*T*(dBp)/(NTC.B + T*(dBp))), 0 - (0 - T*T*(dBp)/(NTC.B + T*(dBp)))), max((0 - T*T*(dBm)/(NTC.B + T*(dBm))), 0 - (0 - T*T*(dBm)/(NTC.B + T*(dBm)))))",
   "source": "same as c07.json"
  },
  {
   "zfl": "E_adc_lb == Dxa*4*(T - Dk)*(T - Dk)/NTC.B",
   "source": "dx(x)/dT = x(1-x) * Rpar/(Rn+Rpar) * B/T^2 <= B/(4 T^2) (hand derivation)"
  },
  {
   "zfl": "E_rp_lb == max(max((0 - T*T*(dRpp)/(NTC.B + T*(dRpp))), 0 - (0 - T*T*(dRpp)/(NTC.B + T*(dRpp)))), max((0 - T*T*(dRpm)/(NTC.B + T*(dRpm))), 0 - (0 - T*T*(dRpm)/(NTC.B + T*(dRpm)))))",
   "source": "c07.json E_Rp at g = Rn/Rpar = 0 (|delta| grows with g)"
  },
  {
   "zfl": "Elb == E_R25 + E_B + E_adc_lb + E_rp_lb",
   "source": "sum of lower bounds"
  }
 ],
 "requirements": [],
