 },
 "define": {
  "th": "H.n*step",
  "thhi": "(H.n+1)*step",
  "Tch": "TS.Tset + dT",
  "tauL1": "tau0L1*PL1.mult",
  "tauL2": "tau0L2*PL2.mult",
  "tauL3": "tau0L3*PL3.mult",
  "tauL4": "tau0L4*PL4.mult"
 },
 "laws": [
  {
   "zfl": "LRL1 == thhi/(4*D121)*(pow(10, (Tch - (Tch - T0)*exp(-(1*thhi/4)/tauL1) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(2*thhi/4)/tauL1) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(3*thhi/4)/tauL1) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(4*thhi/4)/tauL1) - Tref)/zs))",
   "source": "LR = (1/D)*integral 10^((Tcs-Tref)/z) dt; integrand increasing in t so the right Riemann sum at the upper cell end is an upper bound"
  },
  {
   "zfl": "LRL2 == thhi/(4*D121)*(pow(10, (Tch - (Tch - T0)*exp(-(1*thhi/4)/tauL2) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(2*thhi/4)/tauL2) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(3*thhi/4)/tauL2) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(4*thhi/4)/tauL2) - Tref)/zs))",
   "source": "LR = (1/D)*integral 10^((Tcs-Tref)/z) dt; integrand increasing in t so the right Riemann sum at the upper cell end is an upper bound"
  },
  {
   "zfl": "LRL3 == thhi/(4*D121)*(pow(10, (Tch - (Tch - T0)*exp(-(1*thhi/4)/tauL3) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(2*thhi/4)/tauL3) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(3*thhi/4)/tauL3) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(4*thhi/4)/tauL3) - Tref)/zs))",
   "source": "LR = (1/D)*integral 10^((Tcs-Tref)/z) dt; integrand increasing in t so the right Riemann sum at the upper cell end is an upper bound"
  },
  {
   "zfl": "LRL4 == thhi/(4*D121)*(pow(10, (Tch - (Tch - T0)*exp(-(1*thhi/4)/tauL4) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(2*thhi/4)/tauL4) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(3*thhi/4)/tauL4) - Tref)/zs) + pow(10, (Tch - (Tch - T0)*exp(-(4*thhi/4)/tauL4) - Tref)/zs))",
   "source": "LR = (1/D)*integral 10^((Tcs-Tref)/z) dt; integrand increasing in t so the right Riemann sum at the upper cell end is an upper bound"
  },
  {
   "zfl": "Dm == min(min(budL1, budL2), min(budL3, budL4)) - th*pow(10, (TS.Tset + dhi - Tm0)/zm)",
   "source": "thermal damage index, z_m = 25, T_ch,max = T_set + 1.5"
  },
  {
   "zfl": "Pm == min(min(PL1.Tmax, PL2.Tmax), min(PL3.Tmax, PL4.Tmax)) - (TS.Tset + dhi)",
   "source": "packaging limit: T_set + 1.5 <= max chamber temperature of every chosen packaging"
  },
  {
   "zfl": "Wk == cyL1*(ovh + th + TS.dry) + cyL2*(ovh + th + TS.dry) + cyL3*(ovh + th + TS.dry) + cyL4*(ovh + th + TS.dry)",
   "source": "sum of cycles x cycle time"
  }
 ],
 "requirements": [
  {
   "quantity": "LRL1",
   "op": ">=",
   "value": "reqL1",
   "why": "R1 log-reduction L1"
  },
  {
   "quantity": "LRL2",
