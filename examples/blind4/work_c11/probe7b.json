   "why": "R1 log-reduction L4"
  },
  {
   "quantity": "Dm",
   "op": ">=",
   "value": "0",
   "why": "R2 damage budget of every load (same Dm for all, so the smallest budget governs)"
  },
  {
   "quantity": "Pm",
   "op": ">=",
   "value": "0",
   "why": "R3 packaging limit, all loads"
  },
  {
   "quantity": "Wk",
   "op": "<=",
   "value": "Wlim",
   "why": "R4 weekly time"
  }
 ],
 "objective": {
  "minimize": "rate*(cyL1*(ovh + th + TS.dry) + cyL2*(ovh + th + TS.dry) + cyL3*(ovh + th + TS.dry) + cyL4*(ovh + th + TS.dry)) + cyL1*pkL1*PL1.price + cyL2*pkL2*PL2.price + cyL3*pkL3*PL3.price + cyL4*pkL4*PL4.price",
  "unit": "EUR",
  "why": "weekly cost"
 },
