 "define": {
  "Qw": "Pw*sqrt(1 - pfw^2)/pfw",
  "Qsp": "Psp*sqrt(1 - pfsp^2)/pfsp",
  "Qsu": "Psu*sqrt(1 - pfsu^2)/pfsu",
  "Qau": "Pau*sqrt(1 - pfau^2)/pfau",
  "Qn": "Pn*sqrt(1 - pfn^2)/pfn",
  "A0": "(1 - pow(1/1.03, 30))/(1 - 1/1.03)/1.03",
  "A1": "(1 - pow(1.012/1.03, 30))/(1 - 1.012/1.03)/1.03",
  "A2": "(1 - pow(1.012*1.012/1.03, 30))/(1 - 1.012*1.012/1.03)/1.03",
  "g30": "pow(1.012, 29)",
  "rr": "T.Pk/T.Sn",
  "xx": "sqrt(T.uk^2 - rr^2)"
 },
 "laws": [
  {
   "zfl": "Lw == T.P0 + T.Pk*(Pw^2 + (Qw - B.Qc)^2)/T.Sn^2 + kb*B.Qc",
   "source": "seasonal loss P0+Pk(S/Sn)^2+2.5Qc, year 1"
  },
  {
   "zfl": "LYw == A0*(T.P0 + kb*B.Qc) + T.Pk/T.Sn^2*(A2*(Pw^2 + Qw^2) - 2*A1*Qw*B.Qc + A0*B.Qc^2)",
   "source": "sum over y of (loss_y/1.03^y); S_y^2 = g^2(P^2+Q^2) - 2 g Q Qc + Qc^2, g=1.012^(y-1) (hand algebra)"
  },
  {
   "zfl": "S30w == sqrt((g30*Pw)^2 + (g30*Qw - B.Qc)^2)",
   "source": "S = sqrt(P^2+(Q-Qc)^2), year 30"
  },
  {
   "zfl": "dU30w == g30*Pw/T.Sn*rr + (g30*Qw - B.Qc)/T.Sn*xx",
   "source": "delta_U = p r + q x, year 30"
  },
  {
   "zfl": "Lsp == T.P0 + T.Pk*(Psp^2 + (Qsp - B.Qc)^2)/T.Sn^2 + kb*B.Qc",
   "source": "seasonal loss P0+Pk(S/Sn)^2+2.5Qc, year 1"
  },
  {
   "zfl": "LYsp == A0*(T.P0 + kb*B.Qc) + T.Pk/T.Sn^2*(A2*(Psp^2 + Qsp^2) - 2*A1*Qsp*B.Qc + A0*B.Qc^2)",
   "source": "sum over y of (loss_y/1.03^y); S_y^2 = g^2(P^2+Q^2) - 2 g Q Qc + Qc^2, g=1.012^(y-1) (hand algebra)"
  },
  {
   "zfl": "S30sp == sqrt((g30*Psp)^2 + (g30*Qsp - B.Qc)^2)",
   "source": "S = sqrt(P^2+(Q-Qc)^2), year 30"
  },
  {
   "zfl": "dU30sp == g30*Psp/T.Sn*rr + (g30*Qsp - B.Qc)/T.Sn*xx",
   "source": "delta_U = p r + q x, year 30"
  },
  {
   "zfl": "Lsu == T.P0 + T.Pk*(Psu^2 + (Qsu - B.Qc)^2)/T.Sn^2 + kb*B.Qc",
   "source": "seasonal loss P0+Pk(S/Sn)^2+2.5Qc, year 1"
  },
  {
   "zfl": "LYsu == A0*(T.P0 + kb*B.Qc) + T.Pk/T.Sn^2*(A2*(Psu^2 + Qsu^2) - 2*A1*Qsu*B.Qc + A0*B.Qc^2)",
   "source": "sum over y of (loss_y/1.03^y); S_y^2 = g^2(P^2+Q^2) - 2 g Q Qc + Qc^2, g=1.012^(y-1) (hand algebra)"
  },
  {
   "zfl": "S30su == sqrt((g30*Psu)^2 + (g30*Qsu - B.Qc)^2)",
   "source": "S = sqrt(P^2+(Q-Qc)^2), year 30"
  },
  {
   "zfl": "dU30su == g30*Psu/T.Sn*rr + (g30*Qsu - B.Qc)/T.Sn*xx",
   "source": "delta_U = p r + q x, year 30"
  },
  {
   "zfl": "Lau == T.P0 + T.Pk*(Pau^2 + (Qau - B.Qc)^2)/T.Sn^2 + kb*B.Qc",
   "source": "seasonal loss P0+Pk(S/Sn)^2+2.5Qc, year 1"
  },
  {
   "zfl": "LYau == A0*(T.P0 + kb*B.Qc) + T.Pk/T.Sn^2*(A2*(Pau^2 + Qau^2) - 2*A1*Qau*B.Qc + A0*B.Qc^2)",
   "source": "sum over y of (loss_y/1.03^y); S_y^2 = g^2(P^2+Q^2) - 2 g Q Qc + Qc^2, g=1.012^(y-1) (hand algebra)"
  },
  {
   "zfl": "S30au == sqrt((g30*Pau)^2 + (g30*Qau - B.Qc)^2)",
   "source": "S = sqrt(P^2+(Q-Qc)^2), year 30"
  },
  {
   "zfl": "dU30au == g30*Pau/T.Sn*rr + (g30*Qau - B.Qc)/T.Sn*xx",
   "source": "delta_U = p r + q x, year 30"
  },
  {
   "zfl": "E1 == hw*Lw + hsp*Lsp + hsu*Lsu + hau*Lau",
   "source": "annual loss energy year 1 = sum hours*W"
  },
  {
   "zfl": "Ewt == hw*LYw + hsp*LYsp + hsu*LYsu + hau*LYau",
   "source": "discounted loss energy sum_y E_y/1.03^y"
  },
  {
   "zfl": "PV == Tar*Ewt",
   "source": "present value of losses = tariff * discounted energy"
  },
  {
   "zfl": "Tot == T.price + B.price + PV",
   "source": "lifetime cost"
  },
  {
   "zfl": "Mass == T.mass",
   "source": "catalog mass"
  },
  {
   "zfl": "dUn == Pn/T.Sn*rr + (Qn - B.Qc)/T.Sn*xx",
   "source": "delta_U = p r + q x, summer night, year 1"
  }
 ],
