 "define": {
  "E_w": "kE*Q_w",
  "Kc_w": "(-3.4 + 1.95*log10(SRC.Alk/cu*(1-ACID.r)) - (log10((SRC.TDS - 0.26*ACID.r*SRC.Alk)/cu) - 1)/10 + 13.12*log10(T_w/Tu + 273) - 34.55 + log10(SRC.Ca/cu) - 0.4)",
  "Ncap_w": "pow(10, (PROG.Lmax - Kc_w)/2.85)",
  "E_m": "kE*Q_m",
  "Kc_m": "(-3.4 + 1.95*log10(SRC.Alk/cu*(1-ACID.r)) - (log10((SRC.TDS - 0.26*ACID.r*SRC.Alk)/cu) - 1)/10 + 13.12*log10(T_m/Tu + 273) - 34.55 + log10(SRC.Ca/cu) - 0.4)",
  "Ncap_m": "pow(10, (PROG.Lmax - Kc_m)/2.85)",
  "E_s": "kE*Q_s",
  "Kc_s": "(-3.4 + 1.95*log10(SRC.Alk/cu*(1-ACID.r)) - (log10((SRC.TDS - 0.26*ACID.r*SRC.Alk)/cu) - 1)/10 + 13.12*log10(T_s/Tu + 273) - 34.55 + log10(SRC.Ca/cu) - 0.4)",
  "Ncap_s": "pow(10, (PROG.Lmax - Kc_s)/2.85)"
 },
 "laws": [
  {
   "zfl": "gSi_w == Si_lim*(BW.x + Dr) - SRC.Si*(E_w + BW.x + Dr)",
   "source": "N*SiO2_m <= 150 with N=M/(B+D), multiplied by (B+D)>0"
  },
  {
   "zfl": "gCl_w == Cl_lim*(BW.x + Dr) - SRC.Cl*(E_w + BW.x + Dr)",
   "source": "N*Cl_m <= 400 times (B+D)"
  },
  {
   "zfl": "gSO_w == SO_lim*(BW.x + Dr) - (SRC.SO4 + 0.96*ACID.r*SRC.Alk)*(E_w + BW.x + Dr)",
   "source": "N*(SO4_m+0.96 r Alk_m) <= 1000 times (B+D)"
  },
  {
   "zfl": "gLSI_w == Ncap_w*(BW.x + Dr) - (E_w + BW.x + Dr)",
   "source": "LSI = 2.85*log10(N)+K <= Lmax  <=>  N <= 10^((Lmax-K)/2.85) (hand algebra), times (B+D)"
  },
  {
   "zfl": "gSi_m == Si_lim*(BM.x + Dr) - SRC.Si*(E_m + BM.x + Dr)",
   "source": "N*SiO2_m <= 150 with N=M/(B+D), multiplied by (B+D)>0"
  },
  {
   "zfl": "gCl_m == Cl_lim*(BM.x + Dr) - SRC.Cl*(E_m + BM.x + Dr)",
   "source": "N*Cl_m <= 400 times (B+D)"
  },
  {
   "zfl": "gSO_m == SO_lim*(BM.x + Dr) - (SRC.SO4 + 0.96*ACID.r*SRC.Alk)*(E_m + BM.x + Dr)",
   "source": "N*(SO4_m+0.96 r Alk_m) <= 1000 times (B+D)"
  },
  {
   "zfl": "gLSI_m == Ncap_m*(BM.x + Dr) - (E_m + BM.x + Dr)",
   "source": "LSI = 2.85*log10(N)+K <= Lmax  <=>  N <= 10^((Lmax-K)/2.85) (hand algebra), times (B+D)"
  },
  {
   "zfl": "gSi_s == Si_lim*(BS.x + Dr) - SRC.Si*(E_s + BS.x + Dr)",
   "source": "N*SiO2_m <= 150 with N=M/(B+D), multiplied by (B+D)>0"
  },
  {
   "zfl": "gCl_s == Cl_lim*(BS.x + Dr) - SRC.Cl*(E_s + BS.x + Dr)",
   "source": "N*Cl_m <= 400 times (B+D)"
  },
  {
   "zfl": "gSO_s == SO_lim*(BS.x + Dr) - (SRC.SO4 + 0.96*ACID.r*SRC.Alk)*(E_s + BS.x + Dr)",
   "source": "N*(SO4_m+0.96 r Alk_m) <= 1000 times (B+D)"
  },
  {
   "zfl": "gLSI_s == Ncap_s*(BS.x + Dr) - (E_s + BS.x + Dr)",
   "source": "LSI = 2.85*log10(N)+K <= Lmax  <=>  N <= 10^((Lmax-K)/2.85) (hand algebra), times (B+D)"
  },
  {
   "zfl": "Vyr == h_w*(E_w + BW.x + Dr) + h_m*(E_m + BM.x + Dr) + h_s*(E_s + BS.x + Dr)",
   "source": "sum over seasons of hours*M"
  }
