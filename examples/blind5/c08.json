 "laws": [
  {
   "zfl": "Fu == TYR.Crr*KR*M*GR + 0.5*RHO*CDA0*AERO.k*vcu*vcu",
   "source": "road load: rolling + aero"
  },
  {
   "zfl": "Ku == stu*0.5*M*vcu*vcu*(1 - RGEN)",
   "source": "kinetic loss net of regeneration"
  },
  {
   "zfl": "Etu == (Fu + Ku)/ETA",
   "source": "traction energy at battery"
  },
  {
   "zfl": "Ecu == Etu + (PAUX + HEAT.P)/vau",
   "source": "aux energy incl. cabin heating (cold)"
  },
  {
   "zfl": "Ewu == Etu + PAUX/vau",
   "source": "aux energy, no heating (warm)"
  },
  {
   "zfl": "Rgu == U/Ecu",
   "source": "range = usable energy / consumption"
  },
  {
   "zfl": "Fs == TYR.Crr*KR*M*GR + 0.5*RHO*CDA0*AERO.k*vcs*vcs",
   "source": "road load: rolling + aero"
  },
  {
   "zfl": "Ks == sts*0.5*M*vcs*vcs*(1 - RGEN)",
   "source": "kinetic loss net of regeneration"
  },
  {
   "zfl": "Ets == (Fs + Ks)/ETA",
   "source": "traction energy at battery"
  },
  {
   "zfl": "Ecs == Ets + (PAUX + HEAT.P)/vas",
   "source": "aux energy incl. cabin heating (cold)"
  },
  {
   "zfl": "Ews == Ets + PAUX/vas",
   "source": "aux energy, no heating (warm)"
  },
  {
   "zfl": "Rgs == U/Ecs",
   "source": "range = usable energy / consumption"
  },
  {
   "zfl": "Fm == TYR.Crr*KR*M*GR + 0.5*RHO*CDA0*AERO.k*vcm*vcm",
   "source": "road load: rolling + aero"
  },
  {
   "zfl": "Km == stm*0.5*M*vcm*vcm*(1 - RGEN)",
   "source": "kinetic loss net of regeneration"
  },
  {
   "zfl": "Etm == (Fm + Km)/ETA",
   "source": "traction energy at battery"
  },
  {
   "zfl": "Ecm == Etm + (PAUX + HEAT.P)/vam",
   "source": "aux energy incl. cabin heating (cold)"
  },
  {
   "zfl": "Ewm == Etm + PAUX/vam",
   "source": "aux energy, no heating (warm)"
  },
  {
   "zfl": "Rgm == U/Ecm",
   "source": "range = usable energy / consumption"
  },
  {
   "zfl": "U == PACK.E*RET*FT*RES + SOLC*SOL.kWp",
   "source": "retention, cold factor, reserve, solar credit"
  },
  {
   "zfl": "Cons == shu*(HALF*Ecu + HALF*Ewu) + shs*(HALF*Ecs + HALF*Ews) + shm*(HALF*Ecm + HALF*Ewm)",
   "source": "share-weighted half cold/half warm; solar not counted"
  },
  {
   "zfl": "Mg == CURB + PACK.mass + SOL.mass + PAYMAX",
   "source": "gross mass limit"
  }
 ],
