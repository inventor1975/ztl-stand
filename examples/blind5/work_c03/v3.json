   "why": "R3"
  },
  "T": {
   "role": "derived",
   "unit": "C",
   "search": [
    "0",
    "150"
   ],
   "why": "tank temperature: collector heat = load + losses"
  },
  "Bk": {
   "role": "derived",
   "unit": "kWh/day",
   "why": "daily back-up boiler energy"
  },
  "Pmin": {
   "role": "given",
   "value": "4.6",
   "unit": "kEUR",
   "why": "PRE-FILTER (run-time cut, my own): designs cheaper than this were refuted outside the stand"
  },
  "Pmax": {
   "role": "given",
   "value": "4.65",
   "unit": "kEUR",
   "why": "isolate one design"
  }
 },
 "slots": {
  "COL": {
   "from": [
    "collectors"
   ]
  },
  "N": {
   "from": [
    "modules"
   ]
  },
  "TANK": {
   "from": [
    "tanks"
   ]
  },
  "INS": {
   "from": [
    "insulation"
   ]
  }
 },
 "where": [
  "TANK.V/(N.n*COL.A) >= Rmin",
  "TANK.V/(N.n*COL.A) <= Rmax",
  "N.n*COL.price + TANK.price + INS.price >= Pmin",
  "N.n*COL.price + TANK.price + INS.price <= Pmax"
 ],
 "define": {
  "G": "H*dd/hs",
  "UAe": "TANK.UA*INS.f",
  "Tr": "Ta + dTr"
 },
 "laws": [
  {
   "zfl": "N.n*COL.A*H*if(COL.eta0 - COL.a1*(T + dTo - Ta)/G - COL.a2*(T + dTo - Ta)*(T + dTo - Ta)/G > 0, COL.eta0 - COL.a1*(T + dTo - Ta)/G - COL.a2*(T + dTo - Ta)*(T + dTo - Ta)/G, 0) == cw*D*(T - Tc) + UAe*(T - Tr)",
   "source": "daily heat balance: collector useful heat = load + tank loss (0.024 = 24 h/day is carried by the units)"
  },
  {
   "zfl": "Bk == cw*D*if(T > Tt, 0, Tt - T)",
   "source": "back-up boiler tops water up to 45 C"
  }
 ],
