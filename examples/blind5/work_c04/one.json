 "define": {
  "thAd": "4*atan(tAd)",
  "snAd": "4*tAd*(1 - tAd*tAd)/((1 + tAd*tAd)*(1 + tAd*tAd))",
  "AfAd": "DA.D*DA.D/8*(thAd - snAd)",
  "RhAd": "DA.D/4*(1 - snAd/thAd)",
  "thAp": "4*atan(tAp)",
  "snAp": "4*tAp*(1 - tAp*tAp)/((1 + tAp*tAp)*(1 + tAp*tAp))",
  "AfAp": "DA.D*DA.D/8*(thAp - snAp)",
  "RhAp": "DA.D/4*(1 - snAp/thAp)",
  "thBd": "4*atan(tBd)",
  "snBd": "4*tBd*(1 - tBd*tBd)/((1 + tBd*tBd)*(1 + tBd*tBd))",
  "AfBd": "DB.D*DB.D/8*(thBd - snBd)",
  "RhBd": "DB.D/4*(1 - snBd/thBd)",
  "thBp": "4*atan(tBp)",
  "snBp": "4*tBp*(1 - tBp*tBp)/((1 + tBp*tBp)*(1 + tBp*tBp))",
  "AfBp": "DB.D*DB.D/8*(thBp - snBp)",
  "RhBp": "DB.D/4*(1 - snBp/thBp)",
  "costA": "LA*(M.k*pow(DA.D/Dref, 1.3) + (c0 + c1*(H0 + SA.S*LA/2))*(1 + DA.D/Dm))",
  "costB": "LB*(M.k*pow(DB.D/Dref, 1.3) + (c0 + c1*(H0 + SA.S*LA + SB.S*LB/2))*(1 + DB.D/Dm))"
 },
 "laws": [
  {
   "zfl": "pow(QAd*M.n, 6) == pow(AfAd, 6)*pow(RhAd, 4)*pow(SA.S, 3)",
   "source": "Manning (SI) Q = (1/n) A_f R^(2/3) S^(1/2), raised to the 6th power (all sides positive, same root): (Q n)^6 = A_f^6 R^4 S^3; partly full circular pipe, reach A dry peak; operating depth = root t"
  },
  {
   "zfl": "vAd == QAd/AfAd",
   "source": "continuity v = Q/A_f"
  },
  {
   "zfl": "pow(QAp*M.n, 6) == pow(AfAp, 6)*pow(RhAp, 4)*pow(SA.S, 3)",
   "source": "Manning (SI) Q = (1/n) A_f R^(2/3) S^(1/2), raised to the 6th power (all sides positive, same root): (Q n)^6 = A_f^6 R^4 S^3; partly full circular pipe, reach A storm peak; operating depth = root t"
  },
  {
   "zfl": "vAp == QAp/AfAp",
   "source": "continuity v = Q/A_f"
  },
  {
   "zfl": "yA == tAp*tAp/(1 + tAp*tAp)",
   "source": "y/D = (1 - cos(theta/2))/2 = t^2/(1+t^2) with t = tan(theta/4)"
  },
  {
   "zfl": "pow(QBd*M.n, 6) == pow(AfBd, 6)*pow(RhBd, 4)*pow(SB.S, 3)",
   "source": "Manning (SI) Q = (1/n) A_f R^(2/3) S^(1/2), raised to the 6th power (all sides positive, same root): (Q n)^6 = A_f^6 R^4 S^3; partly full circular pipe, reach B dry peak; operating depth = root t"
  },
  {
   "zfl": "vBd == QBd/AfBd",
   "source": "continuity v = Q/A_f"
  },
  {
   "zfl": "pow(QBp*M.n, 6) == pow(AfBp, 6)*pow(RhBp, 4)*pow(SB.S, 3)",
   "source": "Manning (SI) Q = (1/n) A_f R^(2/3) S^(1/2), raised to the 6th power (all sides positive, same root): (Q n)^6 = A_f^6 R^4 S^3; partly full circular pipe, reach B storm peak; operating depth = root t"
  },
  {
   "zfl": "vBp == QBp/AfBp",
   "source": "continuity v = Q/A_f"
  },
  {
   "zfl": "yB == tBp*tBp/(1 + tBp*tBp)",
   "source": "y/D = (1 - cos(theta/2))/2 = t^2/(1+t^2) with t = tan(theta/4)"
  },
  {
   "zfl": "dend == H0 + SA.S*LA + SB.S*LB",
   "source": "constant slope per reach: depth_down = depth_up + S*L; B starts where A ends"
  },
  {
   "zfl": "dDia == DB.D - DA.D",
   "source": "definition"
  }
 ],
