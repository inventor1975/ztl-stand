 },
 "computed": {
  "Dbf": {
   "value": "max(FD.Df - tf, 0*tf)",
   "unit": "m"
  }
 },
 "define": {
  "phi": "phid*pi/180"
 },
 "laws": [
  {
   "zfl": "W == gc*tf*FB.B + gam*FB.B*Dbf",
   "source": "footing + backfill weight, W = 24*0.45*B + gamma*B*max(Df-0.45,0)"
  },
  {
   "zfl": "Nt == N + W",
   "source": "total vertical load"
  },
  {
   "zfl": "e == Mabs/Nt",
   "source": "eccentricity e = |M|/N_t"
  },
  {
   "zfl": "Bp == FB.B - 2*e",
   "source": "effective width B' = B - 2e"
  },
  {
   "zfl": "q == Nt/Bp",
   "source": "contact pressure q = N_t/B'",
   "valid": "Bp > 0"
  },
  {
   "zfl": "Nq == exp(pi*tan(phi))*tan(pi/4 + phi/2)*tan(pi/4 + phi/2)",
   "source": "bearing factor Nq = exp(pi tan phi) tan^2(45 deg + phi/2)"
  },
  {
   "zfl": "Nc == (Nq - 1)/tan(phi)",
   "source": "bearing factor Nc = (Nq-1)/tan phi"
  },
  {
   "zfl": "Ng == (Nq - 1)*tan(1.4*phi)",
   "source": "bearing factor Ngamma = (Nq-1) tan(1.4 phi)"
  },
  {
   "zfl": "q0 == if(zw >= FD.Df, gam*FD.Df, gam*zw + (gam - gw)*(FD.Df - zw))",
   "source": "overburden at founding level, two cases on z_w vs Df"
  },
  {
   "zfl": "gb == if(zw <= FD.Df, gam - gw, if(zw < FD.Df + Bp, (gam - gw) + gw*(zw - FD.Df)/Bp, gam))",
   "source": "unit weight below the base, three cases (z_w<=Df ; Df<z_w<Df+B' ; z_w>=Df+B')"
  },
  {
   "zfl": "qu == c*Nc + q0*Nq + 0.5*gb*Bp*Ng",
   "source": "ultimate bearing pressure"
  },
  {
   "zfl": "FS == qu/q",
   "source": "factor of safety"
  },
  {
   "zfl": "s == q*Bp*(1 - nu*nu)*Is/E",
   "source": "settlement s = q B' (1-0.3^2) 1.12 / E"
  },
  {
   "zfl": "Bw == FB.B",
   "source": "plot-boundary requirement R4 needs a derived quantity"
  }
 ],
 "requirements": [
  {
   "quantity": "FS",
   "op": ">=",
   "value": "3",
   "why": "R1"
  },
  {
   "quantity": "s",
