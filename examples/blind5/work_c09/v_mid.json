  },
  {
   "zfl": "F4 == min(T.cap, max(0, N4 - OWN.B))",
   "source": "Q4: 3PL takes the shortfall first, up to the tier cap"
  },
  {
   "zfl": "S4 == min(Sc4, max(0, N4 - OWN.B - T.cap))",
   "source": "Q4: spot takes what remains after the 3PL cap, up to its availability (hand algebra of min(Sc, max(0, N-B-F)))"
  },
  {
   "zfl": "M4 == max(0, N4 - OWN.B - T.cap - Sc4)",
   "source": "Q4: need left uncovered after own block, 3PL cap and spot availability"
  },
  {
   "zfl": "Bchk == OWN.B",
   "source": "own block size"
  },
  {
   "zfl": "Cost == Cown*OWN.B + 3*T.price*(max(F1, T.commit) + max(F2, T.commit) + max(F3, T.commit) + max(F4, T.commit)) + 3*Ps*(S1 + S2 + S3 + S4)",
   "source": "own lease + 3PL billing max(F,commit)*price*3 months per quarter + spot at its price"
  },
  {
   "zfl": "Mmin == max(max(M1, M2), max(M3, M4))",
   "source": "worst quarter of the uncovered need"
  }
 ],
