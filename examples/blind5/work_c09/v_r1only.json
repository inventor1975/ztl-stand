 },
 "laws": [
  {
   "zfl": "F1 == min(T.cap, max(0, N1 - OWN.B))",
   "source": "Q1: 3PL takes the shortfall first, up to the tier cap"
  },
  {
   "zfl": "S1 == min(Sc1, max(0, N1 - OWN.B - F1))",
   "source": "Q1: spot covers the rest, up to availability"
  },
  {
   "zfl": "M1 == OWN.B + F1 + S1 - N1",
   "source": "Q1: positions provided minus positions needed"
  },
  {
   "zfl": "F2 == min(T.cap, max(0, N2 - OWN.B))",
   "source": "Q2: 3PL takes the shortfall first, up to the tier cap"
  },
  {
   "zfl": "S2 == min(Sc2, max(0, N2 - OWN.B - F2))",
   "source": "Q2: spot covers the rest, up to availability"
  },
  {
   "zfl": "M2 == OWN.B + F2 + S2 - N2",
   "source": "Q2: positions provided minus positions needed"
  },
  {
   "zfl": "F3 == min(T.cap, max(0, N3 - OWN.B))",
   "source": "Q3: 3PL takes the shortfall first, up to the tier cap"
  },
  {
   "zfl": "S3 == min(Sc3, max(0, N3 - OWN.B - F3))",
   "source": "Q3: spot covers the rest, up to availability"
  },
  {
   "zfl": "M3 == OWN.B + F3 + S3 - N3",
   "source": "Q3: positions provided minus positions needed"
  },
  {
   "zfl": "F4 == min(T.cap, max(0, N4 - OWN.B))",
   "source": "Q4: 3PL takes the shortfall first, up to the tier cap"
  },
  {
   "zfl": "S4 == min(Sc4, max(0, N4 - OWN.B - F4))",
   "source": "Q4: spot covers the rest, up to availability"
  },
  {
   "zfl": "M4 == OWN.B + F4 + S4 - N4",
   "source": "Q4: positions provided minus positions needed"
  },
  {
   "zfl": "Bchk == OWN.B",
   "source": "own block size"
  },
  {
   "zfl": "Cost == Cown*OWN.B + 3*T.price*(max(F1, T.commit) + max(F2, T.commit) + max(F3, T.commit) + max(F4, T.commit)) + 3*Ps*(S1 + S2 + S3 + S4)",
   "source": "own lease + 3PL billing max(F,commit)*price*3 months per quarter + spot at its price"
  },
  {
   "zfl": "Mmin == min(min(M1, M2), min(M3, M4))",
   "source": "worst quarter of the coverage margin"
  }
 ],
 "requirements": [
  {
   "quantity": "Mmin",
   "op": ">=",
   "value": "0",
   "why": "R1 every quarter: B+F+S >= needed (F<=cap, S<=spot availability by construction)"
  }
 ],
 "objective": {
  "minimize": "Cost",
  "case": "worst",
  "why": "minimum worst-case annual cost"
 },
