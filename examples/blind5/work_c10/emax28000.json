 "where": [
  "N.k == max(max(MW.k, MS.k), max(MU.k, MA.k))",
  "AE.name != \"PW2\" or OX.name != \"none\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PW2\" or OX.name != \"LOX\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PW37\" or OX.name != \"none\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PW37\" or OX.name != \"LOX\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PROP\" or OX.name != \"none\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PROP\" or OX.name != \"LOX\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"DIFF\" or OX.name != \"none\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"DIFF\" or OX.name != \"LOX\" or (MW.k >= 1 and MW.k <= 2)",
  "AE.name != \"PW2\" or OX.name != \"none\" or (MS.k >= 3 and MS.k <= 4)",
  "AE.name != \"PW2\" or OX.name != \"LOX\" or (MS.k >= 3 and MS.k <= 4)",
  "AE.name != \"PW37\" or OX.name != \"none\" or (MS.k >= 2 and MS.k <= 3)",
  "AE.name != \"PW37\" or OX.name != \"LOX\" or (MS.k >= 2 and MS.k <= 3)",
  "AE.name != \"PROP\" or OX.name != \"none\" or (MS.k >= 4 and MS.k <= 5)",
  "AE.name != \"PROP\" or OX.name != \"LOX\" or (MS.k >= 4 and MS.k <= 5)",
  "AE.name != \"DIFF\" or OX.name != \"none\" or (MS.k >= 2 and MS.k <= 3)",
  "AE.name != \"DIFF\" or OX.name != \"LOX\" or (MS.k >= 2 and MS.k <= 3)",
  "AE.name != \"PW2\" or OX.name != \"none\" or (MU.k >= 12 and MU.k <= 13)",
  "AE.name != \"PW2\" or OX.name != \"LOX\" or (MU.k >= 10 and MU.k <= 11)",
  "AE.name != \"PW37\" or OX.name != \"none\" or (MU.k >= 7 and MU.k <= 8)",
  "AE.name != \"PW37\" or OX.name != \"LOX\" or (MU.k >= 6 and MU.k <= 7)",
  "AE.name != \"PROP\" or OX.name != \"none\" or (MU.k >= 16 and MU.k <= 16)",
  "AE.name != \"PROP\" or OX.name != \"LOX\" or (MU.k >= 16 and MU.k <= 16)",
  "AE.name != \"DIFF\" or OX.name != \"none\" or (MU.k >= 7 and MU.k <= 8)",
  "AE.name != \"DIFF\" or OX.name != \"LOX\" or (MU.k >= 6 and MU.k <= 7)",
  "AE.name != \"PW2\" or OX.name != \"none\" or (MA.k >= 3 and MA.k <= 4)",
  "AE.name != \"PW2\" or OX.name != \"LOX\" or (MA.k >= 3 and MA.k <= 4)",
  "AE.name != \"PW37\" or OX.name != \"none\" or (MA.k >= 2 and MA.k <= 3)",
  "AE.name != \"PW37\" or OX.name != \"LOX\" or (MA.k >= 2 and MA.k <= 3)",
  "AE.name != \"PROP\" or OX.name != \"none\" or (MA.k >= 5 and MA.k <= 6)",
  "AE.name != \"PROP\" or OX.name != \"LOX\" or (MA.k >= 5 and MA.k <= 6)",
  "AE.name != \"DIFF\" or OX.name != \"none\" or (MA.k >= 2 and MA.k <= 3)",
  "AE.name != \"DIFF\" or OX.name != \"LOX\" or (MA.k >= 2 and MA.k <= 3)"
 ],
 "computed": {
  "Etot": {
   "value": "days_winter*hrs_winter*MW.k*AE.P + days_spring*hrs_spring*MS.k*AE.P + days_summer*hrs_summer*MU.k*AE.P + days_autumn*hrs_autumn*MA.k*AE.P",
   "unit": "kWh"
  },
  "cost": {
   "value": "N.k*AE.price + OX.price + yrs*Etot*pe",
   "unit": "kEUR"
  }
 },
 "define": {
  "Cs": "Cu*table(T/Tu, 5, 12.8, 10, 11.3, 15, 10.1, 20, 9.1, 25, 8.3, 30, 7.6, 35, 7.0)",
  "kd": "kd0*pow(1.024, T/Tu - 20)",
  "r": "rf*W*pow(1.08, T/Tu - 20)/Vp + r0*pow(1.065, T/Tu - 20)",
  "ox": "OX.rate/Vp",
  "mrun": "MW.k",
  "a": "mrun*AE.P*AE.SAE*0.90*pow(1.024, T/Tu - 20)/(Cstd*Vp)",
  "Cssd": "((kd + 0.95*a)*Cs - r)/(kd + a)"
 },
 "laws": [
  {
   "zfl": "Css == Cssd",
   "source": "night steady state: r = kd(Cs-C) + aerator transfer/V, solved for C"
  },
  {
   "zfl": "C2 == max(Cs - (r - ox)/kd + (Cssd - (Cs - (r - ox)/kd))*exp(-kd*t2), 0*Cu)",
   "source": "closed form after 2 h power cut, floored at 0"
  },
  {
   "zfl": "Ey == days_winter*hrs_winter*MW.k*AE.P + days_spring*hrs_spring*MS.k*AE.P + days_summer*hrs_summer*MU.k*AE.P + days_autumn*hrs_autumn*MA.k*AE.P",
   "source": "annual aerator energy = sum over seasons of days * night hours * m_s * P"
  },
  {
   "zfl": "Load == N.k*AE.P",
   "source": "connected load n * P"
  }
 ],
 "requirements": [
  {
   "quantity": "Css",
   "op": ">=",
   "value": "4.0",
   "why": "R1: night DO >= 4.0 mg/L in every season, worst case"
  },
  {
   "quantity": "C2",
   "op": ">=",
   "value": "3.0",
   "why": "R2: DO >= 3.0 mg/L after the 2 h power cut, every season"
  },
  {
   "quantity": "Ey",
   "op": "<=",
   "value": "Emax",
   "why": "R3: annual aerator energy <= 31000 kWh"
  },
  {
   "quantity": "Load",
   "op": "<=",
   "value": "Pmax",
   "why": "R4: connected load <= 40 kW"
  }
 ],
