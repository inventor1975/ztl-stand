 "computed": {},
 "define": {
  "Cs": "Cu*table(T/Tu, 5, 12.8, 10, 11.3, 15, 10.1, 20, 9.1, 25, 8.3, 30, 7.6, 35, 7.0)",
  "kd": "kd0*pow(1.024, T/Tu - 20)",
  "r": "rf*W*pow(1.08, T/Tu - 20)/Vp + r0*pow(1.065, T/Tu - 20)",
  "ox": "OX.rate/Vp",
  "mrun": "M.k",
  "a": "mrun*AE.P*AE.SAE*0.90*pow(1.024, T/Tu - 20)/(Cstd*Vp)",
  "Cssd": "((kd + 0.95*a)*Cs - r)/(kd + a)"
 },
 "laws": [
  {
   "zfl": "Css == Cssd",
   "source": "night steady state: r = kd(Cs-C) + aerator transfer/V, solved for C"
  },
  {
   "zfl": "C2 == max(Cs - (r - ox)/kd + (Cssd - (Cs - (r - ox)/kd))*exp(-kd*t2), 0*Cu)",
   "source": "closed form after 2 h power cut, floored at 0"
  }
 ],
