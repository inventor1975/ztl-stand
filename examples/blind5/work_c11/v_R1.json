 "define": {
  "iS1": "1/S1",
  "iM1": "1/min(S1, SK.K)",
  "iS2": "1/S2",
  "iM2": "1/min(S2, SK.K)",
  "iS3": "1/S3",
  "iM3": "1/min(S3, SK.K)",
  "iS4": "1/S4",
  "iM4": "1/min(S4, SK.K)"
 },
 "laws": [
  {
   "zfl": "P1 == U*(v*iS1 + H1.x*(1/F1 - iS1) + SK.on*O1.x*(iM1 - iS1)) - SK.pi*SK.on*O1.x*U - bank*H1.x*U/F1 - Cost",
   "source": "problem statement: quarter profit = revenue - EUR cost"
  },
  {
   "zfl": "G1 == H1.x + SK.on*O1.x",
   "source": "effective hedge fraction in quarter (option fraction forced to 0 when no options)"
  },
  {
   "zfl": "P2 == U*(v*iS2 + H2.x*(1/F2 - iS2) + SK.on*O2.x*(iM2 - iS2)) - SK.pi*SK.on*O2.x*U - bank*H2.x*U/F2 - Cost",
   "source": "problem statement: quarter profit = revenue - EUR cost"
  },
  {
   "zfl": "G2 == H2.x + SK.on*O2.x",
   "source": "effective hedge fraction in quarter (option fraction forced to 0 when no options)"
  },
  {
   "zfl": "P3 == U*(v*iS3 + H3.x*(1/F3 - iS3) + SK.on*O3.x*(iM3 - iS3)) - SK.pi*SK.on*O3.x*U - bank*H3.x*U/F3 - Cost",
   "source": "problem statement: quarter profit = revenue - EUR cost"
  },
  {
   "zfl": "G3 == H3.x + SK.on*O3.x",
   "source": "effective hedge fraction in quarter (option fraction forced to 0 when no options)"
  },
  {
   "zfl": "P4 == U*(v*iS4 + H4.x*(1/F4 - iS4) + SK.on*O4.x*(iM4 - iS4)) - SK.pi*SK.on*O4.x*U - bank*H4.x*U/F4 - Cost",
   "source": "problem statement: quarter profit = revenue - EUR cost"
  },
  {
   "zfl": "G4 == H4.x + SK.on*O4.x",
   "source": "effective hedge fraction in quarter (option fraction forced to 0 when no options)"
  },
  {
   "zfl": "A == P1 + P2 + P3 + P4",
   "source": "annual profit"
  },
  {
   "zfl": "HS == G1 + G2 + G3 + G4",
   "source": "sum of hedge fractions"
  },
  {
   "zfl": "FW == (H1.x + H2.x + H3.x + H4.x)*U",
   "source": "forward notional"
  },
  {
   "zfl": "PR == SK.pi*SK.on*(O1.x + O2.x + O3.x + O4.x)*U",
   "source": "total option premium"
  },
  {
   "zfl": "BK == bank*U*(H1.x/F1 + H2.x/F2 + H3.x/F3 + H4.x/F4)",
   "source": "total bank charge"
  },
  {
   "zfl": "COST == PR + BK",
   "source": "hedging cost"
  }
 ],
 "requirements": [
  {
   "quantity": "P1",
   "op": ">=",
