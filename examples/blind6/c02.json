 "define": {
  "th1": "Tamb + dTr*(Irun1/C1.Iz30)*(Irun1/C1.Iz30)",
  "Rp1": "C1.R20*(1 + alpha*(th1 - Tref))",
  "I1": "Ib1*k1",
  "s1": "sqrt(1 - c1*c1)",
  "th2": "Tamb + dTr*(Irun2/C2.Iz30)*(Irun2/C2.Iz30)",
  "Rp2": "C2.R20*(1 + alpha*(th2 - Tref))",
  "I2": "Ib2*k2",
  "s2": "sqrt(1 - c2*c2)"
 },
 "laws": [
  {
   "zfl": "Vbus == V0 - ks*(I1 + I2)",
   "source": "transformer: V_bus = V0 - ks (I_a + I_b)"
  },
  {
   "zfl": "dV1 == sqrt(3)*I1*L1*(Rp1*c1 + Xp*s1)",
   "source": "3-phase cable drop, R'(theta) from the conductor temperature"
  },
  {
   "zfl": "Vt1 == Vbus - dV1",
   "source": "terminal voltage = V_bus - dV of its feeder"
  },
  {
   "zfl": "Iz1 == C1.Iz30*sqrt((Tins - Tamb)/(Tins - Tcal))",
   "source": "Iz(T) = Iz30 sqrt((90-T)/60)"
  },
  {
   "zfl": "m4_1 == B1.In - 1.1*Irun1",
   "source": "R4 margin"
  },
  {
   "zfl": "m5_1 == 8*B1.In - 1.25*kls1*Iref1",
   "source": "R5 margin"
  },
  {
   "zfl": "m6_1 == Iz1 - B1.In",
   "source": "R6 margin"
  },
  {
   "zfl": "dV2 == sqrt(3)*I2*L2*(Rp2*c2 + Xp*s2)",
   "source": "3-phase cable drop, R'(theta) from the conductor temperature"
  },
  {
   "zfl": "Vt2 == Vbus - dV2",
   "source": "terminal voltage = V_bus - dV of its feeder"
  },
  {
   "zfl": "Iz2 == C2.Iz30*sqrt((Tins - Tamb)/(Tins - Tcal))",
   "source": "Iz(T) = Iz30 sqrt((90-T)/60)"
  },
  {
   "zfl": "m4_2 == B2.In - 1.1*Irun2",
   "source": "R4 margin"
  },
  {
   "zfl": "m5_2 == 8*B2.In - 1.25*kls2*Iref2",
   "source": "R5 margin"
  },
  {
   "zfl": "m6_2 == Iz2 - B2.In",
   "source": "R6 margin"
  }
 ],
