 "define": {
  "th": "Tamb + dTr*(Ir/C.Iz30)*(Ir/C.Iz30)",
  "Rp": "C.R20*(1 + alpha*(th - Tref))"
 },
 "laws": [
  {
   "zfl": "dV1 == sqrt(3)*Ir*L*(Rp*0.85 + Xp*sqrt(1 - 0.85*0.85))",
   "source": "3-phase cable drop, R'(theta)"
  },
  {
   "zfl": "Vt1 == Vb1 - dV1",
   "source": "terminal voltage = V_bus - dV"
  },
  {
   "zfl": "dV2 == sqrt(3)*Is*L*(Rp*0.40 + Xp*sqrt(1 - 0.40*0.40))",
   "source": "3-phase cable drop, R'(theta)"
  },
  {
   "zfl": "Vt2 == Vb2 - dV2",
   "source": "terminal voltage = V_bus - dV"
  },
  {
   "zfl": "dV3 == sqrt(3)*Ir*L*(Rp*0.85 + Xp*sqrt(1 - 0.85*0.85))",
   "source": "3-phase cable drop, R'(theta)"
  },
  {
   "zfl": "Vt3 == Vb3 - dV3",
   "source": "terminal voltage = V_bus - dV"
  },
  {
   "zfl": "Iz == C.Iz30*sqrt((Tins - Tamb)/(Tins - Tcal))",
   "source": "Iz(T) = Iz30 sqrt((90-T)/60)"
  },
  {
   "zfl": "m4 == B.In - 1.1*Ir",
   "source": "R4 margin"
  },
  {
   "zfl": "m5 == 8*B.In - 1.25*Is",
   "source": "R5 margin"
  },
  {
   "zfl": "m6 == Iz - B.In",
   "source": "R6 margin"
  }
 ],
