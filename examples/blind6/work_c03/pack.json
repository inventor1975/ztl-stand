   ]
  },
  "NP": {
   "from": [
    "np"
   ]
  },
  "HT": {
   "from": [
    "heater"
   ]
  }
 },
 "define": {
  "Tc": "Ta + HT.dTh",
  "kT": "max(kfl, 1 - kc*(Tref - Tc))"
 },
 "laws": [
  {
   "zfl": "Rc == a*CELL.R25*exp(B*(1/Tc - 1/Tref))",
   "source": "Arrhenius cell resistance"
  },
  {
   "zfl": "Rpk == 5*Rc/NP.N",
   "source": "5 series groups of Np parallel cells"
  },
  {
   "zfl": "V0 == 5*Voc",
   "source": "5 series groups"
  },
  {
   "zfl": "E == 5*NP.N*CELL.Cap*cf*Vn*dod*kT - HT.Eh",
   "source": "usable energy"
  },
  {
   "zfl": "Imaxc == CELL.Imax25*(1 - ki*(Tref - Tc))",
   "source": "cell current limit at temperature"
  }
 ],
 "requirements": [],
 "objective": {
  "minimize": "5*NP.N*CELL.price + HT.price",
  "unit": "EUR"
 },
