  },
  "Vn": {
   "role": "given",
   "value": "3.6",
   "unit": "V",
   "why": "nominal cell voltage used for energy"
  },
  "dod": {
   "role": "given",
   "value": "0.8",
   "unit": "",
   "why": "usable fraction of the charge"
  },
  "V0": {
   "role": "derived",
   "unit": "V"
  },
  "Rc": {
   "role": "derived",
   "unit": "mohm"
  },
  "Rpk": {
   "role": "derived",
   "unit": "mohm"
  },
  "E": {
   "role": "derived",
   "unit": "Wh"
  },
  "Imaxc": {
   "role": "derived",
   "unit": "A"
  }
 },
 "slots": {
  "CELL": {
   "from": [
