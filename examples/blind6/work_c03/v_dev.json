 "define": {
  "Tc": "Ta + HT.dTh",
  "V0": "5*Voc",
  "kT": "max(kfl, 1 - kc*(Tref - Tc))",
  "Imaxc": "CELL.Imax25*(1 - ki*(Tref - Tc))"
 },
 "laws": [
  {
   "zfl": "Rcell == a*CELL.R25*exp(B*(1/Tc - 1/Tref))",
   "source": "Arrhenius cell resistance (problem statement)"
  },
  {
   "zfl": "Rtot == 5*Rcell/NP.N + BMS.R*kb + Rw",
   "source": "5 series groups of Np parallel cells + BMS + wiring"
  },
  {
   "zfl": "Vt == (V0 + sqrt(max(0, V0*V0 - 4*Rtot*P)))/2",
   "source": "constant-power load on a source V0 with series R: larger root of Vt*(V0-Vt)/R = P",
   "valid": "V0*V0 > 4*Rtot*P"
  },
  {
   "zfl": "I == P/Vt",
   "source": "constant power load"
  },
  {
   "zfl": "Icell == I/NP.N",
   "source": "Np parallel cells share the pack current"
  },
  {
   "zfl": "Vcell == Voc - Icell*Rcell",
   "source": "cell terminal voltage under load"
  },
  {
   "zfl": "E == 5*NP.N*CELL.Cap*cf*Vn*dod*kT - HT.Eh",
   "source": "usable energy, cold-capacity factor, heater draw"
  },
  {
   "zfl": "Runtime == E/P",
   "source": "runtime = energy / power"
  },
  {
   "zfl": "Imarg == Imaxc - Icell",
   "source": "cell current limit at temperature minus cell current"
  }
 ],
