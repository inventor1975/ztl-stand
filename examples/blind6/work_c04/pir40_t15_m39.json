   "source": "self-regulating cable output at Tp and supply V"
  },
  {
   "zfl": "margin == Pc - q",
   "source": "R1 as one quantity: cable output minus heat loss"
  },
  {
   "zfl": "D2 == 2*r2",
   "source": "outer diameter of the insulated pipe"
  }
 ],
