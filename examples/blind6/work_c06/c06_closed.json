 },
 "computed": {
  "g1": "min(1, max(0, EX.N - 1))",
  "g2": "min(1, max(0, EX.N - 2))",
  "g3": "min(1, max(0, EX.N - 3))",
  "p1": "min(1, max(0, EX.N - 2))",
  "p2": "min(1, max(0, EX.N - 3))"
 },
 "laws": [
  {
   "zfl": "A == SS.x*Keff/F",
   "source": "absorption factor"
  },
  {
   "zfl": "Gs == 1 + g1*A + g2*A*A + g3*A*A*A",
   "source": "geometric sum, N terms"
  },
  {
   "zfl": "Gp == 1 + p1*A + p2*A*A",
   "source": "geometric sum, N-1 terms"
  },
  {
   "zfl": "xN == cF*(1 + A*rho*Gp)/(1 + A*rho*Gp + A*(1 - rho)*Gs)",
   "source": "stage balances solved by hand (telescoping), x_N"
  },
  {
   "zfl": "xf == xN*(1 + A*Gp)/(1 + A*rho*Gp)",
   "source": "same, x_1"
  },
  {
   "zfl": "y1 == Keff*xf",
   "source": "loaded solvent"
  },
  {
   "zfl": "Dis == (1 - e)*xN",
   "source": "final discharge"
  },
  {
   "zfl": "Life == qc*BD.m/(F*xN*Hmo)",
   "source": "bed life"
  }
 ],
