   "from": [
    "flow"
   ]
  }
 },
 "define": {
  "Keff": "EX.eta*SV.Kt"
 },
 "computed": {
  "a1": "min(1, max(0, EX.N - 0))",
  "a2": "min(1, max(0, EX.N - 1))",
  "a3": "min(1, max(0, EX.N - 2))",
  "a4": "min(1, max(0, EX.N - 3))",
  "b1": "1 - a1",
  "b2": "1 - a2",
  "b3": "1 - a3",
  "b4": "1 - a4",
  "w1": "a1 - a2",
  "w2": "a2 - a3",
  "w3": "a3 - a4",
  "w4": "a4"
 },
 "laws": [
  {
   "zfl": "a1*F*(z2 - z1) + b1*F*(z1 - cF) == a1*SS.x*Keff*(z1 - rho*xf)",
   "source": "stage N (solvent end): F (x_{N-1}-x_N) = S (Keff x_N - rho Keff x_1)"
  },
  {
   "zfl": "a2*F*(z3 - z2) + b2*F*(z2 - cF) == a2*SS.x*Keff*(z2 - z1)",
   "source": "stage N-1: F (x_{N-2}-x_{N-1}) = S Keff (x_{N-1}-x_N)"
  },
  {
   "zfl": "a3*F*(z4 - z3) + b3*F*(z3 - cF) == a3*SS.x*Keff*(z3 - z2)",
   "source": "stage N-2"
  },
  {
   "zfl": "a4*F*(cF - z4) + b4*F*(z4 - cF) == a4*SS.x*Keff*(z4 - z3)",
   "source": "stage N-3 (x_0 = cF)"
  },
  {
   "zfl": "xN == z1",
   "source": "raffinate is the solvent-end stage"
  },
  {
   "zfl": "xf == w1*z1 + w2*z2 + w3*z3 + w4*z4",
   "source": "x_1 is stage number N from the solvent end"
  },
  {
   "zfl": "y1 == Keff*xf",
   "source": "loaded solvent y_1 = Keff x_1"
  },
  {
   "zfl": "Dis == (1 - e)*xN",
   "source": "final discharge"
  },
  {
   "zfl": "Life == qc*BD.m/(F*xN*Hmo)",
   "source": "bed life = q m /(F x_N)/700"
  }
 ],
