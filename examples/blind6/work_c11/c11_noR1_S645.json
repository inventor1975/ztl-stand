  "SL": {
   "from": [
    "stoploss"
   ]
  },
  "RES": {
   "from": [
    "reserve"
   ]
  }
 },
 "laws": [
  {
   "zfl": "r_n == nS_n*min(sS_n, DED.D) + nL_n*min(sL_n, DED.D)",
   "source": "retained loss before stop-loss = sum over claims of min(severity, D) (normal year)"
  },
  {
   "zfl": "rp_n == r_n - min(max(r_n - SL.A, 0), SL.lim)",
   "source": "retained loss after stop-loss (normal year)"
  },
  {
   "zfl": "T_n == f*DED.prem + SL.price + rp_n + RES.x/20",
   "source": "total cost of a year = f*premium + SL price + r' + 5% of R (normal year)"
  },
  {
   "zfl": "r_b == nS_b*min(sS_b, DED.D) + nL_b*min(sL_b, DED.D)",
   "source": "retained loss before stop-loss = sum over claims of min(severity, D) (bad year)"
  },
  {
   "zfl": "rp_b == r_b - min(max(r_b - SL.A, 0), SL.lim)",
   "source": "retained loss after stop-loss (bad year)"
  },
  {
   "zfl": "T_b == f*DED.prem + SL.price + rp_b + RES.x/20",
   "source": "total cost of a year = f*premium + SL price + r' + 5% of R (bad year)"
  },
  {
   "zfl": "r_c == nS_c*min(sS_c, DED.D) + nL_c*min(sL_c, DED.D) + nC_c*min(sC_c, DED.D)",
   "source": "retained loss before stop-loss = sum over claims of min(severity, D) (catastrophe year)"
  },
  {
   "zfl": "rp_c == r_c - min(max(r_c - SL.A, 0), SL.lim)",
   "source": "retained loss after stop-loss (catastrophe year)"
  },
  {
   "zfl": "T_c == f*DED.prem + SL.price + rp_c + RES.x/20",
   "source": "total cost of a year = f*premium + SL price + r' + 5% of R (catastrophe year)"
  },
  {
   "zfl": "M3 == rp_c - RES.x",
   "source": "liquidity: r' minus reserve (R3 is M3 <= 40, the overdraft line)"
  },
  {
   "zfl": "D4 == rp_b - rp_n",
   "source": "budget stability: r'(bad) - r'(normal)"
  },
  {
   "zfl": "S == T_n + T_b + T_c",
   "source": "sum of the three scenario costs"
  }
 ],
 "requirements": [
  {
   "quantity": "T_b",
   "op": "<=",
   "value": "300",
   "why": "R2 bad-year total cost <= 300 kEUR"
  },
  {
   "quantity": "M3",
   "op": "<=",
   "value": "40",
   "why": "R3 catastrophe-year r' <= R + 40 (overdraft line 40 kEUR)"
  },
  {
   "quantity": "D4",
   "op": "within",
   "value": [
    "-62",
    "62"
   ],
   "why": "R4 |r'(bad) - r'(normal)| <= 62 kEUR"
  },
  {
   "quantity": "S",
   "op": "<=",
   "value": "645",
   "why": "R5 with the sum bound set to 645 by hand (outer bisection)"
  }
 ],
 "objective": {
  "minimize": "S",
  "why": "continuous reserve needs a nominal objective (worst-case objective not available with continuous slots)"
 },
