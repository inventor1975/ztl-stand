{
 "stand": "ztl-stand/1",
 "quantities": {
  "r":   {"role": "given", "range": ["0.09", "0.11"], "unit": "", "why": "discount rate, one value shared by both trucks"},
  "NPV": {"role": "derived", "unit": "USD"},
  "EAA": {"role": "derived", "unit": "USD"}
 },
