  "G": {"role": "given", "range": ["0.02", "0.04"], "unit": "", "why": "downgrade 2-4 %"},
  "dv": {"role": "given", "range": ["0", "5"], "unit": "", "why": "vehicle may exceed posted speed by up to 5 km/h"},
  "tr": {"role": "given", "value": "2.5", "unit": "s", "why": "perception-reaction time"},
  "kc": {"role": "given", "value": "0.278", "unit": "m/s", "why": "0.278 m/s per km/h, as in the formula; v is a plain number in km/h"},
  "gc": {"role": "given", "value": "19.6", "unit": "m/s^2", "why": "constant 19.6 of the formula"},
  "v": {"role": "derived", "unit": "", "why": "actual speed, km/h (number)"},
  "ds": {"role": "derived", "unit": "m", "why": "stopping sight distance"},
  "margin": {"role": "derived", "unit": "m", "why": "ASDmin - ds"},
  "pct": {"role": "derived", "unit": "", "why": "fraction of min ASD by which ds falls below it"}
