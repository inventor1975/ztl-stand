 "slots": {"P": {"from": ["posted"]}},
 "laws": [
  {"zfl": "v == P.Vp + dv", "source": "actual speed between posted and posted + 5 km/h"},
  {"zfl": "ds == kc*tr*v + (kc*v)*(kc*v)/(gc*(P.f - G))", "source": "stopping sight distance formula of the problem"},
  {"zfl": "margin == ASDmin - ds", "source": "margin to the minimum ASD"},
  {"zfl": "pct == margin/ASDmin", "source": "percentage of minimum ASD"}
 ],
