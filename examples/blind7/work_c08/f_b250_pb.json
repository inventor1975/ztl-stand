{"stand": "ztl-stand/1", "quantities": {"P": {"role": "given", "range": ["380", "420"], "unit": "kW", "why": "real power of the load"}, "pf": {"role": "given", "range": ["0.75", "0.79"], "unit": "", "why": "lagging power factor of the load"}, "dl": {"role": "given", "range": ["0.95", "1.05"], "unit": "", "why": "delivered / nameplate kvar"}, "tar": {"role": "given", "value": "3", "unit": "USD/kVA", "why": "demand charge per kVA per month"}, "Q": {"role": "derived", "unit": "kvar", "why": "load reactive power P*tan(arccos(pf))"}, "kVA0": {"role": "derived", "unit": "kVA", "why": "demand before correction"}, "Qnet": {"role": "derived", "unit": "kvar", "why": "reactive power left after the bank"}, "kVA1": {"role": "derived", "unit": "kVA", "why": "demand after correction"}, "pfc": {"role": "derived", "unit": "", "why": "corrected power factor P/kVA"}, "save": {"role": "derived", "unit": "USD", "why": "monthly saving (USD per month)"}, "L": {"role": "given", "value": "40", "unit": ""}}, "slots": {"C": {"from": ["banks"]}}, "laws": [{"zfl": "Q == P*sqrt(1 - pf*pf)/pf", "source": "tan(arccos(pf)) = sqrt(1-pf^2)/pf, exact identity for pf in (0,1]"}, {"zfl": "kVA0 == sqrt(P*P + Q*Q)", "source": "apparent power before correction"}, {"zfl": "Qnet == Q - dl*C.kvar", "source": "delivered kvar = dl * nameplate"}, {"zfl": "kVA1 == sqrt(P*P + Qnet*Qnet)", "source": "apparent power after correction"}, {"zfl": "pfc == P/kVA1", "source": "corrected power factor"}, {"zfl": "save == tar*(kVA0 - kVA1)", "source": "monthly saving = 3.00 * (kVA before - kVA after)"}], "requirements": [{"quantity": "save", "op": ">=", "value": "C.cost/L", "why": "payback cost/save <= L"}], "catalog": {"banks": {"items": [{"kvar": "250", "cost": "8750", "name": "b250"}], "ground": "quote", "fields": {"kvar": {"unit": "kvar"}, "cost": {"unit": "USD"}}}}, "find": {"smallest": "L", "from": "20", "to": "40", "precision": "0.001"}}