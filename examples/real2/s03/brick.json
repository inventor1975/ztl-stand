 "slots": {},
 "define": {
  "R1T": "R1g*(1+t1)*(1+c1*dT)",
  "R2T": "R2g*(1+t2)*(1+c2*dT)"
 },
 "laws": [
  {
   "zfl": "Eoff == (voff + voffTC*dT) + ((ib + ibTC*dT)*(Rs*Kn - R2n) + (iboff + iboffTC*dT)*(Rs*Kn + R2n)/2)/Kn + ((aoff + aoffTC*dT + ares + ainl)*Vlsb)/Kn",
   "source": "source: voff referred to input; ib sensitivity Rs*K-R2, iboff sensitivity (Rs*K+R2)/2, divided by K; ADC terms in LSB*Vlsb divided by K"
  },
  {
   "zfl": "Eg == (1 + R2T/R1T)/Knom*(1+ga)*(1+gc*dT)/((1+vt)*(1+vc*dT)) - 1",
   "source": "gain = (1+R2/R1) * Kadc, Kadc = 4095/Vref, each with tolerance and tempco; relative to nominal"
  }
 ],
