{
  "stand": "ztl-stand/1",
  "quantities": {
    "OD": {
      "role": "given",
      "value": "0.5",
      "tolerance": "0.01",
      "unit": "25.4mm",
      "why": "1/2 in tube OD, tolerance +-0.005 in (datasheet p.3 ASTM A269 example)"
    },
    "S": {
      "role": "given",
      "value": "20000",
      "unit": "6894.757293168Pa",
      "ground": "datasheet",
      "why": "maximum S value 20 000 psi, Table 4 text"
    },
    "Y": {
      "role": "given",
      "value": "0.4",
      "unit": "",
      "why": "B31.3 Table 304.1.1 coefficient (not in the datasheet)"
    },
    "T": {
      "role": "given",
      "range": [
        "200",
        "400"
      ],
      "unit": "",
      "why": "service temperature in degF, between the datasheet's Table 1 knots 200 and 400 (interpolation is MY addition)"
    },
    "P": {
      "role": "given",
      "value": "3470",
      "unit": "6894.757293168Pa",
      "why": "design pressure psig (chosen by me to sit between the published-method limit 3468 and the exact limit 3473)"
    },
