 "laws": [
  {
   "zfl": "vo1 == (1 + R2e/R1e)*(vin + voff + ibp*Rs) - ibn*R2e",
   "source": "non-inverting amp: gain 1+R2/R1 on input+offset+Ibp*Rs, minus Ibn*R2 (eCircuit Center sheet: S(ibn)=-R2, S(ibp)=Rs*Ka)"
  },
  {
   "zfl": "code == 4095*vo1/Vrefe*(1+eg) + oadc + ores + oinl",
   "source": "ADC: Kadc=(2^N-1)/Vref, gain error, offset+resolution+INL as LSB terms"
  },
  {
   "zfl": "Vmeas == code*Vq",
   "source": "reading referred to input: code/(Kadc_nom*Ka_nom)=code/4095 V"
  },
  {
   "zfl": "Err == Vmeas - vin",
   "source": "error referred to input (RTI)"
  }
 ],
