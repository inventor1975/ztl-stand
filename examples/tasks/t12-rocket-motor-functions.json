 },
 "define": {
  "M0": "m_air + M.mass"
 },
 "laws": [
  {
   "zfl": "Dv == M.Isp*g0*ln(M0/(M0 - M.mp))",
   "source": "Tsiolkovsky: dv = Isp*g0*ln(m0/mf)"
  },
  {
   "zfl": "tb == M.Isp*g0*M.mp/M.F",
   "source": "burn time = total impulse / F_avg, It = Isp*g0*mp"
  },
  {
   "zfl": "Dveff == Dv - g0*tb",
   "source": "gravity loss only"
  },
  {
   "zfl": "TWR == M.F/(M0*g0)",
   "source": "thrust-to-weight at liftoff"
  },
  {
   "zfl": "v_rail == sqrt(2*(M.F/M0 - g0)*L)",
   "source": "constant-acceleration rail run"
  },
  {
   "zfl": "amax == M.F/(M0 - M.mp)",
   "source": "F_avg / burnout mass"
  }
 ],
 "requirements": [
  {
   "quantity": "TWR",
   "op": ">=",
   "value": "5",
   "why": "thrust-to-weight >= 5"
  },
  {
