{
 "stand": "universal-stand/1",
 "quantities": {
  "lam": {
   "role": "given",
   "range": [
    "1620",
    "1980"
   ],
   "unit": "1/s",
   "why": "peak arrival rate 1800 req/s +-10%; upper end widened by 0.001 so the nominal (midpoint) never sits exactly on the M/M/1 pole mu = lambda_i"
  },
  "gw": {
   "role": "given",
   "range": [
    "5",
    "12"
   ],
   "unit": "ms",
   "why": "gateway latency"
  },
  "db": {
   "role": "given",
   "range": [
    "15",
    "30"
   ],
   "unit": "ms",
   "why": "database latency"
  },
  "TN": {
   "role": "derived",
   "unit": "ms"
  },
  "TD": {
   "role": "derived",
   "unit": "ms"
  }
 },
 "slots": {
  "INST": {
   "from": [
    "instance_types"
   ]
  },
  "CNT": {
   "from": [
    "counts"
   ]
  }
 },
 "define": {
  "rhoNx": "lam/(CNT.N*INST.mu)",
  "rhoDx": "lam/((CNT.N - 1)*INST.mu)",
  "T99N": "ln(100)/(INST.mu - lam/CNT.N)",
  "T99D": "ln(100)/(INST.mu - lam/(CNT.N - 1))"
 },
 "laws": [
  {
   "zfl": "TN == gw + T99N + db",
   "source": "p99 end-to-end = gateway + ln(100)/(mu - lambda_i) + database (normal)",
   "valid": "INST.mu > lam/CNT.N"
  },
  {
   "zfl": "TD == gw + T99D + db",
   "source": "p99 end-to-end = gateway + ln(100)/(mu - lambda_i) + database (degraded)",
   "valid": "INST.mu > lam/(CNT.N - 1)"
  }
 ],
 "requirements": [
  {
   "quantity": "TN",
   "op": "<=",
   "value": "150",
   "why": "normal: end-to-end p99 <= 150 ms"
  },
  {
   "quantity": "TD",
   "op": "<=",
   "value": "300",
   "why": "degraded: end-to-end p99 <= 300 ms"
  }
 ],
 "objective": {
  "minimize": "INST.price*CNT.N",
  "why": "lowest hourly cost, N instances of one type"
 },
