 "define": {
  "S": "(100 - moist)/86"
 },
 "laws": [
  {
   "zfl": "ME == (MZ.x*ME_mz*S + WH.x*ME_wh + SB.x*ME_sb + SF.x*ME_sf + FM.x*ME_fm + OL.x*ME_ol)/100",
   "source": "sum of inclusion x ME per kg of mix, kcal/kg; maize scaled by moisture"
  },
  {
   "zfl": "CP == (MZ.x*CP_mz*S + WH.x*CP_wh + SB.x*CP_sb + SF.x*CP_sf + FM.x*CP_fm + OL.x*CP_ol + LS.x*CP_ls + DP.x*CP_dp + LY.x*CP_ly + ME.x*CP_me)/100",
   "source": "sum of inclusion x CP, % of mix"
  },
  {
   "zfl": "LYS == (MZ.x*LY_mz*S + WH.x*LY_wh + SB.x*LY_sb + SF.x*LY_sf + FM.x*LY_fm + LY.x*LY_ly)/100",
   "source": "sum of inclusion x Lys, % of mix"
  },
  {
   "zfl": "MCY == (MZ.x*MC_mz*S + WH.x*MC_wh + SB.x*MC_sb + SF.x*MC_sf + FM.x*MC_fm + ME.x*MC_me)/100",
   "source": "sum of inclusion x Met+Cys, % of mix"
  },
  {
   "zfl": "Ca == (MZ.x*0.02*S + WH.x*0.05 + SB.x*0.3 + SF.x*0.4 + FM.x*5.0 + LS.x*38 + DP.x*22)/100",
   "source": "sum of inclusion x Ca, % of mix"
  },
  {
   "zfl": "AP == (MZ.x*0.08*S + WH.x*0.13 + SB.x*0.2 + SF.x*0.25 + FM.x*2.8 + DP.x*18)/100",
   "source": "sum of inclusion x avP, % of mix"
  },
  {
   "zfl": "D1 == Ca - 9/5*AP",
   "source": "Ca:avP >= 1.8  <=>  Ca - 1.8 avP >= 0  (avP > 0)"
  },
  {
   "zfl": "D2 == 12/5*AP - Ca",
   "source": "Ca:avP <= 2.4  <=>  2.4 avP - Ca >= 0  (avP > 0)"
  },
  {
   "zfl": "FIB == (MZ.x*2.2*S + WH.x*2.5 + SB.x*3.9 + SF.x*18 + FM.x*1.0)/100",
   "source": "sum of inclusion x fibre, % of mix"
  },
  {
   "zfl": "TOT == MZ.x + WH.x + SB.x + SF.x + FM.x + OL.x + LS.x + DP.x + LY.x + ME.x",
   "source": "the batch"
  },
  {
   "zfl": "MW == MZ.x + WH.x",
   "source": "cereal share"
  }
 ],
