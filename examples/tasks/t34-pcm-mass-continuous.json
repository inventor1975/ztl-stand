 "define": {
  "Vin": "(Lx-2*INS.t)*(Ly-2*INS.t)*(Lz-2*INS.t)",
  "Aout": "2*(Lx*Ly+Lx*Lz+Ly*Lz)",
  "Ain": "2*((Lx-2*INS.t)*(Ly-2*INS.t)+(Lx-2*INS.t)*(Lz-2*INS.t)+(Ly-2*INS.t)*(Lz-2*INS.t))",
  "Am": "sqrt(Aout*Ain)",
  "UA": "INS.k*Am/INS.t",
  "dT": "sg*(Ta-Tm)",
  "m": "PCM.m"
 },
 "laws": [
  {
   "zfl": "t1 == f*m*Llat/(UA*dT)",
   "source": "phase 1 duration t1 = f m L/(UA |Ta-5|)"
  },
  {
   "zfl": "tau == (Cp + m*cpcm)/UA",
   "source": "time constant"
  },
  {
   "zfl": "Tend == Tm + sg*dT*(1 - exp(-max(0, tend - t1)/tau))",
   "source": "phase 2 exponential approach (T=5 if t1>=48h)"
  },
  {
   "zfl": "Vmargin == Vin - Vpay - m/rpcm",
   "source": "R3: interior volume contains payload and PCM"
  },
  {
   "zfl": "Mtot == Mpay + Mshell + INS.rho*(Lx*Ly*Lz - Vin) + m",
   "source": "mass formula"
  }
 ],
