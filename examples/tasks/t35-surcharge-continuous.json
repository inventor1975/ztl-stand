 "define": {
  "Tv1": "cv1*t/(H1*H1)",
  "De1": "105/100*SP1.s",
  "nn1": "De1/DR.dw",
  "Tr1": "cv1*rch1*t/(De1*De1)",
  "Tv2": "cv2*t/(H2*H2)",
  "De2": "105/100*SP2.s",
  "nn2": "De2/DR.dw",
  "Tr2": "cv2*rch2*t/(De2*De2)",
  "hs": "HS.h"
 },
 "laws": [
  {
   "zfl": "S01 == Cc1*H1/(1+e01)*log10((sg1+Hf*gam)/sg1)",
   "source": "final settlement, log10 compression law, permanent load"
  },
  {
   "zfl": "Ssur1 == Cc1*H1/(1+e01)*log10((sg1+(Hf+hs)*gam)/sg1)",
   "source": "final settlement, log10 compression law, load incl. surcharge"
  },
  {
   "zfl": "Uv1 == if(Tv1 < 1/5, 2*sqrt(Tv1/pi), 1 - 8/(pi*pi)*exp(-pi*pi*Tv1/4))",
   "source": "vertical consolidation, Terzaghi (two branches)"
  },
  {
   "zfl": "F1 == ln(nn1/sm1) + rk1*ln(sm1) - 3/4",
   "source": "Hansbo with smear"
  },
  {
   "zfl": "Ur1 == 1 - exp(-8*Tr1/F1)",
   "source": "Hansbo radial consolidation"
  },
  {
   "zfl": "U1 == 1 - (1-Uv1)*(1-Ur1)",
   "source": "Carrillo combination"
  },
  {
   "zfl": "M1 == U1*Ssur1 - S01 + Sres",
   "source": "requirement margin: achieved settlement minus (permanent minus residual)"
  },
  {
   "zfl": "S02 == Cc2*H2/(1+e02)*log10((sg2+Hf*gam)/sg2)",
   "source": "final settlement, log10 compression law, permanent load"
  },
  {
   "zfl": "Ssur2 == Cc2*H2/(1+e02)*log10((sg2+(Hf+hs)*gam)/sg2)",
   "source": "final settlement, log10 compression law, load incl. surcharge"
  },
  {
   "zfl": "Uv2 == if(Tv2 < 1/5, 2*sqrt(Tv2/pi), 1 - 8/(pi*pi)*exp(-pi*pi*Tv2/4))",
   "source": "vertical consolidation, Terzaghi (two branches)"
  },
  {
   "zfl": "F2 == ln(nn2/sm2) + rk2*ln(sm2) - 3/4",
   "source": "Hansbo with smear"
  },
  {
   "zfl": "Ur2 == 1 - exp(-8*Tr2/F2)",
   "source": "Hansbo radial consolidation"
  },
  {
   "zfl": "U2 == 1 - (1-Uv2)*(1-Ur2)",
   "source": "Carrillo combination"
  },
  {
   "zfl": "M2 == U2*Ssur2 - S02 + Sres",
   "source": "requirement margin: achieved settlement minus (permanent minus residual)"
  }
 ],
