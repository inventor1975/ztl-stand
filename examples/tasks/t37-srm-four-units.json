 "laws": [
  {
   "zfl": "Ab == GN.N*(pi*GD.d*GL.Lg + 2*(pi/4)*(D*D - GD.d*GD.d))",
   "source": "SPEC.md"
  },
  {
   "zfl": "At == (pi/4)*NT.Dt*NT.Dt",
   "source": "SPEC.md"
  },
  {
   "zfl": "Kn == Ab/At",
   "source": "SPEC.md"
  },
  {
   "zfl": "P == pow(0.000000001*Kn*PR.rho*PR.cstar*PR.a, 1/(1 - PR.n))",
   "source": "SPEC.md"
  },
  {
   "zfl": "mp == PR.rho*GN.N*(pi/4)*(D*D - GD.d*GD.d)*GL.Lg*0.000000001",
   "source": "SPEC.md"
  },
  {
   "zfl": "NE.eps == (1/Me)*pow((2/(PR.gamma + 1))*(1 + (PR.gamma - 1)/2*Me*Me), (PR.gamma + 1)/(2*(PR.gamma - 1)))",
   "source": "SPEC.md"
  },
  {
   "zfl": "q == 1/pow(1 + (PR.gamma - 1)/2*Me*Me, PR.gamma/(PR.gamma - 1))",
   "source": "SPEC.md"
  },
  {
   "zfl": "mom == sqrt(2*PR.gamma*PR.gamma/(PR.gamma - 1)*pow(2/(PR.gamma + 1), (PR.gamma + 1)/(PR.gamma - 1))*(1 - pow(q, (PR.gamma - 1)/PR.gamma)))",
   "source": "SPEC.md"
  },
  {
   "zfl": "Cf == mom + (q - Pa/P)*NE.eps",
   "source": "SPEC.md"
  },
  {
   "zfl": "F == eta*Cf*P*At",
   "source": "SPEC.md"
  },
  {
   "zfl": "It == eta*Cf*PR.cstar*mp",
   "source": "SPEC.md"
  },
  {
   "zfl": "sigma == (sqrt(3)/2)*P*30/CT.t",
   "source": "SPEC.md"
  },
  {
   "zfl": "CR == Sy/(1.5*sigma)",
   "source": "SPEC.md"
  },
  {
   "zfl": "mc == 2700*pi*(60 + CT.t)*CT.t*(GN.N*GL.Lg + 40)*0.000000001",
   "source": "SPEC.md"
  },
  {
   "zfl": "mn == 0.08 + 0.02*NE.eps",
   "source": "SPEC.md"
  },
  {
   "zfl": "m0 == mair + mp + mc + mn",
   "source": "SPEC.md"
  },
  {
   "zfl": "tb == It/F",
   "source": "SPEC.md"
  },
  {
   "zfl": "dv == (It/mp)*ln(m0/(m0 - mp)) - gg*tb",
   "source": "SPEC.md"
  },
  {
   "zfl": "TWR == F/(m0*gg)",
   "source": "SPEC.md"
  },
  {
   "zfl": "vr == sqrt(2*(F/m0 - gg)*Lr)",
   "source": "SPEC.md"
  },
  {
   "zfl": "amaxg == F/((m0 - mp)*gg)",
   "source": "SPEC.md"
  },
  {
   "zfl": "SEP == q*P/(0.4*Pa)",
   "source": "SPEC.md"
  },
  {
   "zfl": "Cost == PR.price*mp + 8*mc + 10 + 3*NE.eps",
   "source": "SPEC.md"
  }
 ],
