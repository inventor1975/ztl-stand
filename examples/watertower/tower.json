 "define": {
  "q": "rho_a*vb*vb/2",
  "Ft": "q*Cd*Dt*Ht",
  "Fs": "q*Cd*S.D*H",
  "Mb": "Ft*(H + Ht/2) + Fs*H/2",
  "Nk": "(mw + mtank + S.m*H)*g0",
  "Wf": "gc*F.B*F.B*hf"
 },
 "laws": [
  {
   "zfl": "sigma == 1.35*Nk/S.A + 1.5*Mb/S.W",
   "source": "axial + bending stress at the shaft base, factored"
  },
  {
   "zfl": "ub == 3*1.35*Nk*4*H*H/(pi*pi*E*S.I)",
   "source": "Euler, free-standing cantilever (effective length 2H), safety 3"
  },
  {
   "zfl": "delta == Ft*H*H*H/(3*E*S.I) + Fs*H*H*H/(8*E*S.I)",
   "source": "cantilever sway: tank force at the top, shaft wind uniform"
  },
  {
   "zfl": "pmax == (Nk + Wf)/(F.B*F.B) + 6*Mb/(F.B*F.B*F.B)",
   "source": "edge soil pressure, resultant within the kern"
  },
  {
   "zfl": "kern == (Nk + Wf)*F.B/6 - Mb",
   "source": "resultant inside the middle third: no uplift"
  }
 ],
 "requirements": [
  {
   "quantity": "sigma",
   "op": "<=",
   "value": "fy/1.1",
   "why": "steel resistance, gamma_M = 1.1"
  },
  {
   "quantity": "ub",
   "op": "<=",
   "value": "1",
   "why": "Euler load at least 3x the factored weight"
  },
  {
   "quantity": "delta",
