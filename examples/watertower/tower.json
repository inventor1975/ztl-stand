   "value": "H/150",
   "why": "sway limit at the tank floor"
  },
  {
   "quantity": "pmax",
   "op": "<=",
   "value": "qa",
   "why": "soil pressure within the allowable"
  },
  {
   "quantity": "kern",
   "op": ">=",
   "value": "0",
   "why": "no uplift under any wind, tank empty or full"
  }
 ],
 "objective": {
  "minimize": "S.pm*H + F.price",
  "unit": "EUR"
 }
